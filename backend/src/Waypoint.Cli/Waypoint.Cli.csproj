<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>way</AssemblyName>
    <RootNamespace>Waypoint.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>way</ToolCommandName>
    <PackageId>Waypoint.Cli</PackageId>
    <Version>1.0.0</Version>
    <Authors>Waypoint contributors</Authors>
    <Description>Operational administration and database lifecycle tool for Waypoint.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="System.CommandLine" Version="2.0.10" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Waypoint.Application\Waypoint.Application.csproj" />
    <ProjectReference Include="..\Waypoint.Infrastructure\Waypoint.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
