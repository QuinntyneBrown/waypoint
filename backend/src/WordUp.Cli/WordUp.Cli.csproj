<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>wu</AssemblyName>
    <RootNamespace>WordUp.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>wu</ToolCommandName>
    <PackageId>WordUp.Cli</PackageId>
    <Version>1.0.0</Version>
    <Authors>Word Up contributors</Authors>
    <Description>Operational administration and database lifecycle tool for Word Up.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="System.CommandLine" Version="2.0.10" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WordUp.Application\WordUp.Application.csproj" />
    <ProjectReference Include="..\WordUp.Infrastructure\WordUp.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
