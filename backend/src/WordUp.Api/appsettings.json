{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "InMemory"
  },
  "Jwt": {
    "Issuer": "WordUp",
    "Audience": "WordUp",
    "SigningKey": "REPLACE_WITH_AT_LEAST_32_CHARACTER_RANDOM_SECRET_VALUE",
    "AccessTokenMinutes": 60
  },
  "AuditIntegrity": {
    "SigningKey": "REPLACE_WITH_AT_LEAST_32_CHARACTER_RANDOM_SECRET_VALUE"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Security": {
    "SensitiveRateLimit": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    }
  },
  "AtRiskThresholds": {
    "InactiveDays": 7,
    "MissedSessions": 1,
    "ProgressBelowCohortPercentage": 15
  }
}
