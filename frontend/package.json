{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve portal",
    "start:public": "ng serve public-site --port 4201",
    "build": "npm run packages:build && npm run apps:build && npm run packages:check",
    "apps:build": "ng build portal && ng build public-site",
    "packages:build": "ng build api && ng build components && ng build auth && ng build core && ng build account && ng build youth && ng build mentor && ng build admin && ng build guardian && ng build volunteer",
    "packages:check": "node scripts/check-package-artifacts.mjs",
    "watch": "ng build portal --watch --configuration development",
    "test": "ng test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:build": "dotnet build ../backend/Waypoint.sln",
    "api": "dotnet run --project ../backend/src/Waypoint.Api --environment Development --urls http://127.0.0.1:5211",
    "e2e": "playwright test",
    "e2e:ci": "playwright test --project=portal --project=public-site --project=portal-xs --project=quality-*",
    "e2e:performance": "playwright test --project=youth-performance --workers=1",
    "e2e:quality": "playwright test e2e/quality",
    "e2e:ui": "playwright test --ui",
    "quality:routes": "node scripts/check-route-manifest.mjs",
    "serve:ssr:public-site": "node dist/public-site/server/server.mjs",
    "lint": "ng lint",
    "storybook": "ng run components:storybook",
    "build-storybook": "ng run components:build-storybook",
    "prepare": "cd .. && husky frontend/.husky"
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/platform-server": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@angular/ssr": "^21.2.27",
    "@microsoft/signalr": "^9.0.6",
    "@microsoft/signalr-protocol-msgpack": "^9.0.19",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2102.27",
    "@angular-devkit/build-angular": "^21.2.27",
    "@angular-devkit/core": "^21.2.27",
    "@angular/build": "^21.2.27",
    "@angular/cli": "^21.2.27",
    "@angular/compiler-cli": "^21.2.25",
    "@angular/platform-browser-dynamic": "^21.2.25",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/angular": "^10.6.2",
    "@types/express": "^5.0.1",
    "@types/node": "^22.20.5",
    "angular-eslint": "21.4.0",
    "eslint": "^10.3.0",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^17.6.0",
    "ng-packagr": "^21.2.0",
    "prettier": "^3.8.1",
    "storybook": "^10.6.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.71.2",
    "vitest": "^4.0.8"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,json,css,md}": "prettier --write"
  }
}
