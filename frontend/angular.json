        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/components/**/*.ts", "projects/components/**/*.html"],
            "eslintConfig": "projects/components/eslint.config.js"
          }
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": "projects/components/.storybook",
            "browserTarget": "components:build",
            "compodoc": false,
            "styles": [
              "projects/components/src/styles/fonts.css",
              "projects/components/src/styles/core.css",
              "projects/components/src/styles/a11y.css"
            ],
            "port": 6006
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": "projects/components/.storybook",
            "browserTarget": "components:build",
            "compodoc": false,
            "styles": [
              "projects/components/src/styles/fonts.css",
              "projects/components/src/styles/core.css",
              "projects/components/src/styles/a11y.css"
            ],
            "outputDir": "dist/storybook/components"
          }
        }
      }
    },
