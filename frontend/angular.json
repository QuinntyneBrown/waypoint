{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "portal": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/portal",
      "sourceRoot": "projects/portal/src",
      "prefix": "wu",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/portal/src/main.ts",
            "tsConfig": "projects/portal/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/portal/public"
              }
            ],
            "styles": [
              "projects/wu-ui/src/styles/fonts.css",
              "projects/wu-ui/src/styles/core.css",
              "projects/portal/src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4200,
            "proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "portal:build:production"
            },
            "development": {
              "buildTarget": "portal:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    },
    "wu-ui": {
      "projectType": "library",
      "root": "projects/wu-ui",
      "sourceRoot": "projects/wu-ui/src",
      "prefix": "wu",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/wu-ui/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/wu-ui/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/wu-ui/tsconfig.spec.json"
          }
        }
      }
    },
    "wu-api": {
      "projectType": "library",
      "root": "projects/wu-api",
      "sourceRoot": "projects/wu-api/src",
      "prefix": "wu",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/wu-api/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/wu-api/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/wu-api/tsconfig.spec.json"
          }
        }
      }
    },
    "wu-auth": {
      "projectType": "library",
      "root": "projects/wu-auth",
      "sourceRoot": "projects/wu-auth/src",
      "prefix": "wu",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/wu-auth/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/wu-auth/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/wu-auth/tsconfig.spec.json"
          }
        }
      }
    },
    "public-site": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/public-site",
      "sourceRoot": "projects/public-site/src",
      "prefix": "wu",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/public-site/src/main.ts",
            "tsConfig": "projects/public-site/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/public-site/public"
              }
            ],
            "styles": [
              "projects/wu-ui/src/styles/fonts.css",
              "projects/wu-ui/src/styles/core.css",
              "projects/public-site/src/styles.css"
            ],
            "server": "projects/public-site/src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": []
            },
            "ssr": {
              "entry": "projects/public-site/src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "public-site:build:production"
            },
            "development": {
              "buildTarget": "public-site:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 4201,
            "proxyConfig": "proxy.conf.json"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
