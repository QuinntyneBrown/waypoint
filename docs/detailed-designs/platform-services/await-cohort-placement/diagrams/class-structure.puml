@startuml
left to right direction
title UML class structure — Await cohort placement
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
package "Frontend — Portal application" {
  class "ConsentRequired" as page_ConsentRequired <<Angular component>> {
    +load(): void
    +renderResult(): void
  }
  class "DisplayPreferencesApi" as client_DisplayPreferencesApi <<API client>> {
    +get(request): Observable
  }
}
package "Backend — Waypoint API application" {
  class "AccessController" as controller_AccessController <<controller>> {
    +GetAsync(request, cancellationToken): ActionResult
  }
}
package "Backend — Waypoint Application" {
  class "AccessStateQuery" as request_AccessStateQuery <<record>>
  class "AccessStateQueryHandler" as handler_AccessStateQueryHandler <<handler>> {
    +Handle(request, cancellationToken): Result
  }
  interface IAppDbContext {
    +SaveChangesAsync(cancellationToken): int
  }
  interface ICurrentUser {
    +Id: Guid
    +Role: string
  }
}
package "Backend — Waypoint Domain" {
  class "SupportRequest" as entity_SupportRequest <<domain type>>
}
page_ConsentRequired --> client_DisplayPreferencesApi : invokes
client_DisplayPreferencesApi --> controller_AccessController : calls
controller_AccessController ..> request_AccessStateQuery : creates
request_AccessStateQuery --> handler_AccessStateQueryHandler : dispatched to
handler_AccessStateQueryHandler --> IAppDbContext : depends on
handler_AccessStateQueryHandler --> ICurrentUser : scopes by
handler_AccessStateQueryHandler --> entity_SupportRequest : reads or changes
IAppDbContext o-- entity_SupportRequest : persists
legend right
  Solid arrows show runtime collaboration.
  Dashed arrows show construction.
  Aggregation shows persistence ownership.
endlegend
@enduml
