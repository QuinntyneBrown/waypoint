@startuml
left to right direction
title UML class structure — Edit a profile
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
package "Frontend — Portal application" {
  class "SettingsProfile" as page_SettingsProfile <<Angular component>> {
    +submit(): void
    +renderResult(): void
  }
  class "ProfileApi" as client_ProfileApi <<API client>> {
    +execute(request): Observable
  }
}
package "Backend — WordUp API application" {
  class "ProfileController" as controller_ProfileController <<controller>> {
    +PostAsync(request, cancellationToken): ActionResult
  }
}
package "Backend — WordUp Application" {
  class "UpdateProfileCommand" as request_UpdateProfileCommand <<record>>
  class "UpdateProfileCommandHandler" as handler_UpdateProfileCommandHandler <<handler>> {
    +Handle(request, cancellationToken): Result
  }
  interface IAppDbContext {
    +SaveChangesAsync(cancellationToken): int
  }
  interface ICurrentUser {
    +Id: Guid
    +Role: string
  }
}
package "Backend — WordUp Domain" {
  class "SupportRequest" as entity_SupportRequest <<domain type>>
}
page_SettingsProfile --> client_ProfileApi : invokes
client_ProfileApi --> controller_ProfileController : calls
controller_ProfileController ..> request_UpdateProfileCommand : creates
request_UpdateProfileCommand --> handler_UpdateProfileCommandHandler : dispatched to
handler_UpdateProfileCommandHandler --> IAppDbContext : depends on
handler_UpdateProfileCommandHandler --> ICurrentUser : scopes by
handler_UpdateProfileCommandHandler --> entity_SupportRequest : reads or changes
IAppDbContext o-- entity_SupportRequest : persists
legend right
  Solid arrows show runtime collaboration.
  Dashed arrows show construction.
  Aggregation shows persistence ownership.
endlegend
@enduml
