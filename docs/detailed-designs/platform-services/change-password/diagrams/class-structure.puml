@startuml
left to right direction
title UML class structure — Change a password
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
package "Frontend — Portal application" {
  class "ForgotPassword" as page_ForgotPassword <<Angular component>> {
    +submit(): void
    +renderResult(): void
  }
  class "PasswordResetApi" as client_PasswordResetApi <<API client>> {
    +execute(request): Observable
  }
}
package "Backend — Waypoint API application" {
  class "AccessController" as controller_AccessController <<controller>> {
    +PostAsync(request, cancellationToken): ActionResult
  }
}
package "Backend — Waypoint Application" {
  class "ChangePasswordCommand" as request_ChangePasswordCommand <<record>>
  class "ChangePasswordCommandHandler" as handler_ChangePasswordCommandHandler <<handler>> {
    +Handle(request, cancellationToken): Result
  }
  interface IAppDbContext {
    +SaveChangesAsync(cancellationToken): int
  }
  interface ICurrentUser {
    +Id: Guid
    +Role: string
  }
}
package "Backend — Waypoint Domain" {
  class "SupportRequest" as entity_SupportRequest <<domain type>>
}
page_ForgotPassword --> client_PasswordResetApi : invokes
client_PasswordResetApi --> controller_AccessController : calls
controller_AccessController ..> request_ChangePasswordCommand : creates
request_ChangePasswordCommand --> handler_ChangePasswordCommandHandler : dispatched to
handler_ChangePasswordCommandHandler --> IAppDbContext : depends on
handler_ChangePasswordCommandHandler --> ICurrentUser : scopes by
handler_ChangePasswordCommandHandler --> entity_SupportRequest : reads or changes
IAppDbContext o-- entity_SupportRequest : persists
legend right
  Solid arrows show runtime collaboration.
  Dashed arrows show construction.
  Aggregation shows persistence ownership.
endlegend
@enduml
