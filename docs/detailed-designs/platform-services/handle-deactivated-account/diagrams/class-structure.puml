@startuml
left to right direction
title UML class structure — Handle a deactivated account
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
package "Frontend — Portal application" {
  class "AccountDeactivated" as page_AccountDeactivated <<Angular component>> {
    +submit(): void
    +renderResult(): void
  }
  class "PasswordResetApi" as client_PasswordResetApi <<API client>> {
    +execute(request): Observable
  }
}
package "Backend — WordUp API application" {
  class "SupportController" as controller_SupportController <<controller>> {
    +PostAsync(request, cancellationToken): ActionResult
  }
}
package "Backend — WordUp Application" {
  class "HandleDeactivatedAccountCommand" as request_HandleDeactivatedAccountCommand <<record>>
  class "HandleDeactivatedAccountCommandHandler" as handler_HandleDeactivatedAccountCommandHandler <<handler>> {
    +Handle(request, cancellationToken): Result
  }
  interface IAppDbContext {
    +SaveChangesAsync(cancellationToken): int
  }
  interface ICurrentUser {
    +Id: Guid
    +Role: string
  }
}
package "Backend — WordUp Domain" {
  class "SupportRequest" as entity_SupportRequest <<domain type>>
}
page_AccountDeactivated --> client_PasswordResetApi : invokes
client_PasswordResetApi --> controller_SupportController : calls
controller_SupportController ..> request_HandleDeactivatedAccountCommand : creates
request_HandleDeactivatedAccountCommand --> handler_HandleDeactivatedAccountCommandHandler : dispatched to
handler_HandleDeactivatedAccountCommandHandler --> IAppDbContext : depends on
handler_HandleDeactivatedAccountCommandHandler --> ICurrentUser : scopes by
handler_HandleDeactivatedAccountCommandHandler --> entity_SupportRequest : reads or changes
IAppDbContext o-- entity_SupportRequest : persists
legend right
  Solid arrows show runtime collaboration.
  Dashed arrows show construction.
  Aggregation shows persistence ownership.
endlegend
@enduml
