end box
box "Backend — WordUp API application" #D1FADF
  participant "SupportController" as controller
end box
box "Backend — WordUp Application and Domain" #ECFDF3
  participant "SubmitSupportRequestCommandHandler" as handler
  participant "SupportRequest" as entity
end box
box "Backend — WordUp Infrastructure" #FFF4E5
  database "Word Up database" as db
end box
