@startuml
left to right direction
title UML class structure — Configure display preferences
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
package "Frontend — Portal application" {
  class "DisplayPreferencesService" as page_DisplayPreferencesService <<Angular component>> {
    +submit(): void
    +renderResult(): void
  }
  class "DisplayPreferencesApi" as client_DisplayPreferencesApi <<API client>> {
    +execute(request): Observable
  }
}
package "Backend — Waypoint API application" {
  class "PreferencesController" as controller_PreferencesController <<controller>> {
    +PostAsync(request, cancellationToken): ActionResult
  }
}
package "Backend — Waypoint Application" {
  class "DisplayPreferenceQuery" as request_DisplayPreferenceQuery <<record>>
  class "DisplayPreferenceQueryHandler" as handler_DisplayPreferenceQueryHandler <<handler>> {
    +Handle(request, cancellationToken): Result
  }
  interface IAppDbContext {
    +SaveChangesAsync(cancellationToken): int
  }
  interface ICurrentUser {
    +Id: Guid
    +Role: string
  }
}
package "Backend — Waypoint Domain" {
  class "DisplayPreference" as entity_DisplayPreference <<domain type>>
}
page_DisplayPreferencesService --> client_DisplayPreferencesApi : invokes
client_DisplayPreferencesApi --> controller_PreferencesController : calls
controller_PreferencesController ..> request_DisplayPreferenceQuery : creates
request_DisplayPreferenceQuery --> handler_DisplayPreferenceQueryHandler : dispatched to
handler_DisplayPreferenceQueryHandler --> IAppDbContext : depends on
handler_DisplayPreferenceQueryHandler --> ICurrentUser : scopes by
handler_DisplayPreferenceQueryHandler --> entity_DisplayPreference : reads or changes
IAppDbContext o-- entity_DisplayPreference : persists
legend right
  Solid arrows show runtime collaboration.
  Dashed arrows show construction.
  Aggregation shows persistence ownership.
endlegend
@enduml
