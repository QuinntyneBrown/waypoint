@startuml
left to right direction
title UML class structure — Author the progression framework
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
package "Frontend — Portal application" {
  class "AttendanceQueueService" as page_AttendanceQueueService <<Angular component>> {
    +submit(): void
    +renderResult(): void
  }
  class "CurriculumAuthoringApi" as client_CurriculumAuthoringApi <<API client>> {
    +execute(request): Observable
  }
}
package "Backend — Waypoint API application" {
  class "ProgressionController" as controller_ProgressionController <<controller>> {
    +PostAsync(request, cancellationToken): ActionResult
  }
}
package "Backend — Waypoint Application" {
  class "AddCompetencyCommand" as request_AddCompetencyCommand <<record>>
  class "AddCompetencyCommandHandler" as handler_AddCompetencyCommandHandler <<handler>> {
    +Handle(request, cancellationToken): Result
  }
  interface IAppDbContext {
    +SaveChangesAsync(cancellationToken): int
  }
  interface ICurrentUser {
    +Id: Guid
    +Role: string
  }
}
package "Backend — Waypoint Domain" {
  class "Competency" as entity_Competency <<domain type>>
}
page_AttendanceQueueService --> client_CurriculumAuthoringApi : invokes
client_CurriculumAuthoringApi --> controller_ProgressionController : calls
controller_ProgressionController ..> request_AddCompetencyCommand : creates
request_AddCompetencyCommand --> handler_AddCompetencyCommandHandler : dispatched to
handler_AddCompetencyCommandHandler --> IAppDbContext : depends on
handler_AddCompetencyCommandHandler --> ICurrentUser : scopes by
handler_AddCompetencyCommandHandler --> entity_Competency : reads or changes
IAppDbContext o-- entity_Competency : persists
legend right
  Solid arrows show runtime collaboration.
  Dashed arrows show construction.
  Aggregation shows persistence ownership.
endlegend
@enduml
