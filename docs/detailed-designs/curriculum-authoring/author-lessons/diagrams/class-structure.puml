@startuml
left to right direction
title UML class structure — Author lessons
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
package "Frontend — Portal application" {
  class "AuthorLessonsPage" as page_AuthorLessonsPage <<Angular component>> {
    +submit(): void
    +renderResult(): void
  }
  class "CurriculumAuthoringApi" as client_CurriculumAuthoringApi <<API client>> {
    +execute(request): Observable
  }
}
package "Backend — Waypoint API application" {
  class "LessonsController" as controller_LessonsController <<controller>> {
    +PostAsync(request, cancellationToken): ActionResult
  }
}
package "Backend — Waypoint Application" {
  class "CreateLessonCommand" as request_CreateLessonCommand <<record>>
  class "CreateLessonCommandHandler" as handler_CreateLessonCommandHandler <<handler>> {
    +Handle(request, cancellationToken): Result
  }
  interface IAppDbContext {
    +SaveChangesAsync(cancellationToken): int
  }
  interface ICurrentUser {
    +Id: Guid
    +Role: string
  }
}
package "Backend — Waypoint Domain" {
  class "Lesson" as entity_Lesson <<domain type>>
}
page_AuthorLessonsPage --> client_CurriculumAuthoringApi : invokes
client_CurriculumAuthoringApi --> controller_LessonsController : calls
controller_LessonsController ..> request_CreateLessonCommand : creates
request_CreateLessonCommand --> handler_CreateLessonCommandHandler : dispatched to
handler_CreateLessonCommandHandler --> IAppDbContext : depends on
handler_CreateLessonCommandHandler --> ICurrentUser : scopes by
handler_CreateLessonCommandHandler --> entity_Lesson : reads or changes
IAppDbContext o-- entity_Lesson : persists
legend right
  Solid arrows show runtime collaboration.
  Dashed arrows show construction.
  Aggregation shows persistence ownership.
endlegend
@enduml
