@startuml
left to right direction
title UML class structure — Award badges
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
package "Frontend — Portal application" {
  class "SettingsNotifications" as page_SettingsNotifications <<Angular component>> {
    +submit(): void
    +renderResult(): void
  }
  class "NotificationPreferencesApi" as client_NotificationPreferencesApi <<API client>> {
    +execute(request): Observable
  }
}
package "Backend — WordUp API application" {
  class "BadgesController" as controller_BadgesController <<controller>> {
    +PostAsync(request, cancellationToken): ActionResult
  }
}
package "Backend — WordUp Application" {
  class "AwardBadgeCommand" as request_AwardBadgeCommand <<record>>
  class "AwardBadgeCommandHandler" as handler_AwardBadgeCommandHandler <<handler>> {
    +Handle(request, cancellationToken): Result
  }
  interface IAppDbContext {
    +SaveChangesAsync(cancellationToken): int
  }
  interface ICurrentUser {
    +Id: Guid
    +Role: string
  }
}
package "Backend — WordUp Domain" {
  class "Badge" as entity_Badge <<domain type>>
}
page_SettingsNotifications --> client_NotificationPreferencesApi : invokes
client_NotificationPreferencesApi --> controller_BadgesController : calls
controller_BadgesController ..> request_AwardBadgeCommand : creates
request_AwardBadgeCommand --> handler_AwardBadgeCommandHandler : dispatched to
handler_AwardBadgeCommandHandler --> IAppDbContext : depends on
handler_AwardBadgeCommandHandler --> ICurrentUser : scopes by
handler_AwardBadgeCommandHandler --> entity_Badge : reads or changes
IAppDbContext o-- entity_Badge : persists
legend right
  Solid arrows show runtime collaboration.
  Dashed arrows show construction.
  Aggregation shows persistence ownership.
endlegend
@enduml
