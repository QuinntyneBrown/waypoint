@startuml
left to right direction
title UML class structure — Manage guardian contact details
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
package "Frontend — Portal application" {
  class "Contact" as page_Contact <<Angular component>> {
    +submit(): void
    +renderResult(): void
  }
  class "AuthService" as client_AuthApi <<API client>> {
    +execute(request): Observable
  }
}
package "Backend — Waypoint API application" {
  class "GuardianController" as controller_GuardianController <<controller>> {
    +PostAsync(request, cancellationToken): ActionResult
  }
}
package "Backend — Waypoint Application" {
  class "UpdateGuardianContactCommand" as request_UpdateGuardianContactCommand <<record>>
  class "UpdateGuardianContactCommandHandler" as handler_UpdateGuardianContactCommandHandler <<handler>> {
    +Handle(request, cancellationToken): Result
  }
  interface IAppDbContext {
    +SaveChangesAsync(cancellationToken): int
  }
  interface ICurrentUser {
    +Id: Guid
    +Role: string
  }
}
package "Backend — Waypoint Domain" {
  class "GuardianProfile" as entity_GuardianProfile <<domain type>>
}
page_Contact --> client_AuthApi : invokes
client_AuthApi --> controller_GuardianController : calls
controller_GuardianController ..> request_UpdateGuardianContactCommand : creates
request_UpdateGuardianContactCommand --> handler_UpdateGuardianContactCommandHandler : dispatched to
handler_UpdateGuardianContactCommandHandler --> IAppDbContext : depends on
handler_UpdateGuardianContactCommandHandler --> ICurrentUser : scopes by
handler_UpdateGuardianContactCommandHandler --> entity_GuardianProfile : reads or changes
IAppDbContext o-- entity_GuardianProfile : persists
legend right
  Solid arrows show runtime collaboration.
  Dashed arrows show construction.
  Aggregation shows persistence ownership.
endlegend
@enduml
