@startuml
left to right direction
title UML class structure — Sync offline attendance
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
package "Frontend — Portal application" {
  class "OfflineState" as page_OfflineState <<Angular component>> {
    +submit(): void
    +renderResult(): void
  }
  class "EngagementApi" as client_EngagementApi <<API client>> {
    +execute(request): Observable
  }
}
package "Backend — WordUp API application" {
  class "AttendanceController" as controller_AttendanceController <<controller>> {
    +PostAsync(request, cancellationToken): ActionResult
  }
}
package "Backend — WordUp Application" {
  class "AttendanceHistoryBySessionQuery" as request_AttendanceHistoryBySessionQuery <<record>>
  class "AttendanceHistoryBySessionQueryHandler" as handler_AttendanceHistoryBySessionQueryHandler <<handler>> {
    +Handle(request, cancellationToken): Result
  }
  interface IAppDbContext {
    +SaveChangesAsync(cancellationToken): int
  }
  interface ICurrentUser {
    +Id: Guid
    +Role: string
  }
}
package "Backend — WordUp Domain" {
  class "AttendanceRecord" as entity_AttendanceRecord <<domain type>>
}
page_OfflineState --> client_EngagementApi : invokes
client_EngagementApi --> controller_AttendanceController : calls
controller_AttendanceController ..> request_AttendanceHistoryBySessionQuery : creates
request_AttendanceHistoryBySessionQuery --> handler_AttendanceHistoryBySessionQueryHandler : dispatched to
handler_AttendanceHistoryBySessionQueryHandler --> IAppDbContext : depends on
handler_AttendanceHistoryBySessionQueryHandler --> ICurrentUser : scopes by
handler_AttendanceHistoryBySessionQueryHandler --> entity_AttendanceRecord : reads or changes
IAppDbContext o-- entity_AttendanceRecord : persists
legend right
  Solid arrows show runtime collaboration.
  Dashed arrows show construction.
  Aggregation shows persistence ownership.
endlegend
@enduml
