@startuml

title UML sequence behaviour — RSVP to a session
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Mentor, volunteer, or program administrator" as actor
box "Frontend — Portal application" #E0F2FE
  participant "SessionPersistence" as page
  participant "NotificationPreferencesApi" as client
end box
box "Backend — Waypoint API application" #D1FADF
  participant "RsvpController" as controller
end box
box "Backend — Waypoint Application and Domain" #ECFDF3
  participant "CreateSessionCommandHandler" as handler
  participant "Session" as entity
end box
box "Backend — Waypoint Infrastructure" #FFF4E5
  database "Waypoint database" as db
end box
actor -> page : Start rsvp to a session
page -> client : Build typed request
client -> controller : HTTPS request
controller -> controller : Authenticate and apply endpoint policy
controller -> handler : Send CreateSessionCommand
handler -> db : Load and persist authorized state
db --> handler : Current state
handler -> entity : Apply L2-ENGAGE-005, L2-ENGAGE-008, L2-AUTH-010 feature rules
entity --> handler : Valid state transition or projection
handler -> db : Save changes in one unit of work
db --> handler : Commit or query result
handler --> controller : Typed result
controller --> client : HTTP response or ProblemDetails
client --> page : Feature result
page --> actor : Present rsvp to a session result
@enduml
