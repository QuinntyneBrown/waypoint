@startuml
left to right direction
title UML class structure — Complete a coding lesson
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
package "Frontend — Portal application" {
  class "YouthAnnouncements" as page_YouthAnnouncements <<Angular component>> {
    +submit(): void
    +renderResult(): void
  }
  class "LearningExperienceApi" as client_LearningExperienceApi <<API client>> {
    +execute(request): Observable
  }
}
package "Backend — Waypoint API application" {
  class "YouthCurriculumController" as controller_YouthCurriculumController <<controller>> {
    +PostAsync(request, cancellationToken): ActionResult
  }
}
package "Backend — Waypoint Application" {
  class "CompleteLessonCommand" as request_CompleteLessonCommand <<record>>
  class "CompleteLessonCommandHandler" as handler_CompleteLessonCommandHandler <<handler>> {
    +Handle(request, cancellationToken): Result
  }
  interface IAppDbContext {
    +SaveChangesAsync(cancellationToken): int
  }
  interface ICurrentUser {
    +Id: Guid
    +Role: string
  }
}
package "Backend — Waypoint Domain" {
  class "BadgeAward" as entity_BadgeAward <<domain type>>
}
page_YouthAnnouncements --> client_LearningExperienceApi : invokes
client_LearningExperienceApi --> controller_YouthCurriculumController : calls
controller_YouthCurriculumController ..> request_CompleteLessonCommand : creates
request_CompleteLessonCommand --> handler_CompleteLessonCommandHandler : dispatched to
handler_CompleteLessonCommandHandler --> IAppDbContext : depends on
handler_CompleteLessonCommandHandler --> ICurrentUser : scopes by
handler_CompleteLessonCommandHandler --> entity_BadgeAward : reads or changes
IAppDbContext o-- entity_BadgeAward : persists
legend right
  Solid arrows show runtime collaboration.
  Dashed arrows show construction.
  Aggregation shows persistence ownership.
endlegend
@enduml
