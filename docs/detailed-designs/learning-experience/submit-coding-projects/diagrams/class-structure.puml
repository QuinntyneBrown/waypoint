@startuml
left to right direction
title UML class structure — Submit a coding project
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
package "Frontend — Portal application" {
  class "YouthAnnouncements" as page_YouthAnnouncements <<Angular component>> {
    +submit(): void
    +renderResult(): void
  }
  class "AnnouncementsService" as client_AnnouncementsApi <<API client>> {
    +execute(request): Observable
  }
}
package "Backend — Waypoint API application" {
  class "YouthCurriculumController" as controller_YouthCurriculumController <<controller>> {
    +PostAsync(request, cancellationToken): ActionResult
  }
}
package "Backend — Waypoint Application" {
  class "SubmitAssignmentCommand" as request_SubmitAssignmentCommand <<record>>
  class "SubmitAssignmentCommandHandler" as handler_SubmitAssignmentCommandHandler <<handler>> {
    +Handle(request, cancellationToken): Result
  }
  interface IAppDbContext {
    +SaveChangesAsync(cancellationToken): int
  }
  interface ICurrentUser {
    +Id: Guid
    +Role: string
  }
}
package "Backend — Waypoint Domain" {
  class "Submission" as entity_Submission <<domain type>>
}
page_YouthAnnouncements --> client_AnnouncementsApi : invokes
client_AnnouncementsApi --> controller_YouthCurriculumController : calls
controller_YouthCurriculumController ..> request_SubmitAssignmentCommand : creates
request_SubmitAssignmentCommand --> handler_SubmitAssignmentCommandHandler : dispatched to
handler_SubmitAssignmentCommandHandler --> IAppDbContext : depends on
handler_SubmitAssignmentCommandHandler --> ICurrentUser : scopes by
handler_SubmitAssignmentCommandHandler --> entity_Submission : reads or changes
IAppDbContext o-- entity_Submission : persists
legend right
  Solid arrows show runtime collaboration.
  Dashed arrows show construction.
  Aggregation shows persistence ownership.
endlegend
@enduml
