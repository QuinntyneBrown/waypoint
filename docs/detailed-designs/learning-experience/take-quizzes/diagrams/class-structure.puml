@startuml
left to right direction
title UML class structure — Take a quiz
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
package "Frontend — Portal application" {
  class "YouthAnnouncements" as page_YouthAnnouncements <<Angular component>> {
    +submit(): void
    +renderResult(): void
  }
  class "LearningExperienceService" as client_LearningExperienceApi <<API client>> {
    +execute(request): Observable
  }
}
package "Backend — Waypoint API application" {
  class "QuizTakingController" as controller_QuizTakingController <<controller>> {
    +PostAsync(request, cancellationToken): ActionResult
  }
}
package "Backend — Waypoint Application" {
  class "SubmitQuizAttemptCommand" as request_SubmitQuizAttemptCommand <<record>>
  class "SubmitQuizAttemptCommandHandler" as handler_SubmitQuizAttemptCommandHandler <<handler>> {
    +Handle(request, cancellationToken): Result
  }
  interface IAppDbContext {
    +SaveChangesAsync(cancellationToken): int
  }
  interface ICurrentUser {
    +Id: Guid
    +Role: string
  }
}
package "Backend — Waypoint Domain" {
  class "QuizAttempt" as entity_QuizAttempt <<domain type>>
}
page_YouthAnnouncements --> client_LearningExperienceApi : invokes
client_LearningExperienceApi --> controller_QuizTakingController : calls
controller_QuizTakingController ..> request_SubmitQuizAttemptCommand : creates
request_SubmitQuizAttemptCommand --> handler_SubmitQuizAttemptCommandHandler : dispatched to
handler_SubmitQuizAttemptCommandHandler --> IAppDbContext : depends on
handler_SubmitQuizAttemptCommandHandler --> ICurrentUser : scopes by
handler_SubmitQuizAttemptCommandHandler --> entity_QuizAttempt : reads or changes
IAppDbContext o-- entity_QuizAttempt : persists
legend right
  Solid arrows show runtime collaboration.
  Dashed arrows show construction.
  Aggregation shows persistence ownership.
endlegend
@enduml
