@startuml

title UML sequence behaviour — Track and revise a submission
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Youth participant" as actor
box "Frontend — Portal application" #E0F2FE
  participant "YouthNotifications" as page
  participant "NotificationPreferencesApi" as client
end box
box "Backend — Waypoint API application" #D1FADF
  participant "SubmissionsController" as controller
end box
box "Backend — Waypoint Application and Domain" #ECFDF3
  participant "SubmissionStatusQueryHandler" as handler
  participant "Submission" as entity
end box
box "Backend — Waypoint Infrastructure" #FFF4E5
  database "Waypoint database" as db
end box
actor -> page : Start track and revise a submission
page -> client : Build typed request
client -> controller : HTTPS request
controller -> controller : Authenticate and apply endpoint policy
controller -> handler : Send SubmissionStatusQuery
handler -> db : Load and persist authorized state
db --> handler : Current state
handler -> entity : Apply L2-LEARN-007, L2-MENTOR-003, L2-NFR-005 feature rules
entity --> handler : Valid state transition or projection
handler -> db : Save changes in one unit of work
db --> handler : Commit or query result
handler --> controller : Typed result
controller --> client : HTTP response or ProblemDetails
client --> page : Feature result
page --> actor : Present track and revise a submission result
@enduml
