@startuml

title UML sequence behaviour — Browse curriculum
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Youth participant" as actor
box "Frontend — Portal application" #E0F2FE
  participant "YouthAnnouncements" as page
  participant "PublicSiteApi" as client
end box
box "Backend — WordUp API application" #D1FADF
  participant "YouthCurriculumController" as controller
end box
box "Backend — WordUp Application and Domain" #ECFDF3
  participant "BrowseCurriculumQueryHandler" as handler
  participant "LessonProgress" as entity
end box
box "Backend — WordUp Infrastructure" #FFF4E5
  database "Word Up database" as db
end box
actor -> page : Start browse curriculum
page -> client : Build typed request
client -> controller : HTTPS request
controller -> controller : Authenticate and apply endpoint policy
controller -> handler : Send BrowseCurriculumQuery
handler -> db : Query authorized state
db --> handler : Current state
handler -> entity : Apply L2-LEARN-001, L2-AUTH-009, L2-CURRIC-001 feature rules
entity --> handler : Valid state transition or projection
handler -> db : Complete bounded projection
db --> handler : Commit or query result
handler --> controller : Typed result
controller --> client : HTTP response or ProblemDetails
client --> page : Feature result
page --> actor : Present browse curriculum result
@enduml
