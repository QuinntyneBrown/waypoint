@startuml
!include <C4/C4_Component>
LAYOUT_LEFT_RIGHT()
title C4 level 3 — Complete a lesson — components
System_Boundary(waypoint, "Waypoint software system") {
  Container_Boundary(frontend, "Frontend") {
    Container_Boundary(frontend_app, "Portal application") {
      Component(page, "YouthAnnouncements", "Angular page component", "Owns feature interaction state and presentation")
      Component(client, "SupportApi", "Typed API client", "Calls the feature API with typed requests and results")
    }
  }
  Container_Boundary(backend, "Backend") {
    Container_Boundary(api_app, "Waypoint API application") {
      Component(controller, "YouthCurriculumController", "API controller", "Applies transport policy and maps requests")
    }
    Container_Boundary(application, "Waypoint Application") {
      Component(request, "CompleteLessonCommand", "MediatR request", "Represents the application use case")
      Component(handler, "CompleteLessonCommandHandler", "MediatR handler", "Coordinates authorized feature behavior")
    }
    Container_Boundary(domain, "Waypoint Domain") {
      Component(entity, "BadgeAward", "Domain type", "Holds feature state and invariants")
    }
    Container_Boundary(infrastructure, "Waypoint Infrastructure") {
      Component(persistence, "AppDbContext", "EF Core adapter", "Queries and persists authoritative state")
    }
  }
}
Rel(page, client, "Calls")
Rel(client, controller, "Calls", "HTTPS JSON")
Rel(controller, request, "Constructs")
Rel(controller, handler, "Sends through MediatR")
Rel(handler, entity, "Reads or changes")
Rel(handler, persistence, "Queries or persists")
Rel(persistence, entity, "Maps")
SHOW_LEGEND()
@enduml
