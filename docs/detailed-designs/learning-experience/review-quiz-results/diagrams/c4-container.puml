@startuml
!include <C4/C4_Component>
LAYOUT_LEFT_RIGHT()
title C4 level 2 — Review quiz results — containers
Person(primary, "Youth participant", "Uses the feature")
System_Boundary(waypoint, "Waypoint software system") {
  Container_Boundary(frontend, "Frontend") {
    Container(app1, "Portal application", "Angular", "Review quiz results interaction")
  }
  Container_Boundary(backend, "Backend") {
    Container(api, "Waypoint API application", "ASP.NET Core", "Authentication, policy, and feature endpoints")
    Container(realtime, "Realtime gateway", "SignalR", "Feature change delivery")
  }
  ContainerDb(db, "Waypoint database", "SQL Server", "Authoritative feature state")
}
Rel(primary, app1, "Uses")
Rel(app1, api, "Calls", "HTTPS JSON")
Rel(api, db, "Reads and writes", "EF Core")
Rel(api, realtime, "Publishes authorized changes")
Rel(realtime, app1, "Pushes subscribed events", "SignalR")
SHOW_LEGEND()
@enduml
