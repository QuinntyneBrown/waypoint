@startuml
left to right direction
title UML class structure — Review quiz results
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
package "Frontend — Portal application" {
  class "YouthAnnouncements" as page_YouthAnnouncements <<Angular component>> {
    +submit(): void
    +renderResult(): void
  }
  class "LearningExperienceApi" as client_LearningExperienceApi <<API client>> {
    +execute(request): Observable
  }
}
package "Backend — WordUp API application" {
  class "QuizTakingController" as controller_QuizTakingController <<controller>> {
    +PostAsync(request, cancellationToken): ActionResult
  }
}
package "Backend — WordUp Application" {
  class "QuizResultQuery" as request_QuizResultQuery <<record>>
  class "QuizResultQueryHandler" as handler_QuizResultQueryHandler <<handler>> {
    +Handle(request, cancellationToken): Result
  }
  interface IAppDbContext {
    +SaveChangesAsync(cancellationToken): int
  }
  interface ICurrentUser {
    +Id: Guid
    +Role: string
  }
}
package "Backend — WordUp Domain" {
  class "QuizAttempt" as entity_QuizAttempt <<domain type>>
}
page_YouthAnnouncements --> client_LearningExperienceApi : invokes
client_LearningExperienceApi --> controller_QuizTakingController : calls
controller_QuizTakingController ..> request_QuizResultQuery : creates
request_QuizResultQuery --> handler_QuizResultQueryHandler : dispatched to
handler_QuizResultQueryHandler --> IAppDbContext : depends on
handler_QuizResultQueryHandler --> ICurrentUser : scopes by
handler_QuizResultQueryHandler --> entity_QuizAttempt : reads or changes
IAppDbContext o-- entity_QuizAttempt : persists
legend right
  Solid arrows show runtime collaboration.
  Dashed arrows show construction.
  Aggregation shows persistence ownership.
endlegend
@enduml
