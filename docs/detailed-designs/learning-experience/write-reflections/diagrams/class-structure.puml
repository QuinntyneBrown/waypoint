@startuml
left to right direction
title UML class structure — Write a reflection
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
package "Frontend — Portal application" {
  class "YouthAnnouncements" as page_YouthAnnouncements <<Angular component>> {
    +submit(): void
    +renderResult(): void
  }
  class "AuthService" as client_AuthApi <<API client>> {
    +execute(request): Observable
  }
}
package "Backend — Waypoint API application" {
  class "ReflectionsController" as controller_ReflectionsController <<controller>> {
    +PostAsync(request, cancellationToken): ActionResult
  }
}
package "Backend — Waypoint Application" {
  class "SaveReflectionCommand" as request_SaveReflectionCommand <<record>>
  class "SaveReflectionCommandHandler" as handler_SaveReflectionCommandHandler <<handler>> {
    +Handle(request, cancellationToken): Result
  }
  interface IAppDbContext {
    +SaveChangesAsync(cancellationToken): int
  }
  interface ICurrentUser {
    +Id: Guid
    +Role: string
  }
}
package "Backend — Waypoint Domain" {
  class "ReflectionEntry" as entity_ReflectionEntry <<domain type>>
}
page_YouthAnnouncements --> client_AuthApi : invokes
client_AuthApi --> controller_ReflectionsController : calls
controller_ReflectionsController ..> request_SaveReflectionCommand : creates
request_SaveReflectionCommand --> handler_SaveReflectionCommandHandler : dispatched to
handler_SaveReflectionCommandHandler --> IAppDbContext : depends on
handler_SaveReflectionCommandHandler --> ICurrentUser : scopes by
handler_SaveReflectionCommandHandler --> entity_ReflectionEntry : reads or changes
IAppDbContext o-- entity_ReflectionEntry : persists
legend right
  Solid arrows show runtime collaboration.
  Dashed arrows show construction.
  Aggregation shows persistence ownership.
endlegend
@enduml
