@startuml
left to right direction
title UML class structure — Review personal progress
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
package "Frontend — Portal application" {
  class "YouthAnnouncements" as page_YouthAnnouncements <<Angular component>> {
    +submit(): void
    +renderResult(): void
  }
  class "AuthApi" as client_AuthApi <<API client>> {
    +execute(request): Observable
  }
}
package "Backend — Waypoint API application" {
  class "YouthProgressController" as controller_YouthProgressController <<controller>> {
    +PostAsync(request, cancellationToken): ActionResult
  }
}
package "Backend — Waypoint Application" {
  class "ProgressQuery" as request_ProgressQuery <<record>>
  class "ProgressQueryHandler" as handler_ProgressQueryHandler <<handler>> {
    +Handle(request, cancellationToken): Result
  }
  interface IAppDbContext {
    +SaveChangesAsync(cancellationToken): int
  }
  interface ICurrentUser {
    +Id: Guid
    +Role: string
  }
}
package "Backend — Waypoint Domain" {
  class "LessonProgress" as entity_LessonProgress <<domain type>>
}
page_YouthAnnouncements --> client_AuthApi : invokes
client_AuthApi --> controller_YouthProgressController : calls
controller_YouthProgressController ..> request_ProgressQuery : creates
request_ProgressQuery --> handler_ProgressQueryHandler : dispatched to
handler_ProgressQueryHandler --> IAppDbContext : depends on
handler_ProgressQueryHandler --> ICurrentUser : scopes by
handler_ProgressQueryHandler --> entity_LessonProgress : reads or changes
IAppDbContext o-- entity_LessonProgress : persists
legend right
  Solid arrows show runtime collaboration.
  Dashed arrows show construction.
  Aggregation shows persistence ownership.
endlegend
@enduml
