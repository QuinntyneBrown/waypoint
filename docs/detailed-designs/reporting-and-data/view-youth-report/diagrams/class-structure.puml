@startuml
left to right direction
title UML class structure — View a youth report
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
package "Frontend — Portal application" {
  class "YouthAnnouncements" as page_YouthAnnouncements <<Angular component>> {
    +load(): void
    +renderResult(): void
  }
  class "AuthApi" as client_AuthApi <<API client>> {
    +get(request): Observable
  }
}
package "Backend — WordUp API application" {
  class "ReportsController" as controller_ReportsController <<controller>> {
    +GetAsync(request, cancellationToken): ActionResult
  }
}
package "Backend — WordUp Application" {
  class "YouthReportQuery" as request_YouthReportQuery <<record>>
  class "YouthReportQueryHandler" as handler_YouthReportQueryHandler <<handler>> {
    +Handle(request, cancellationToken): Result
  }
  interface IAppDbContext {
    +SaveChangesAsync(cancellationToken): int
  }
  interface ICurrentUser {
    +Id: Guid
    +Role: string
  }
}
package "Backend — WordUp Domain" {
  class "ViewYouthReportState" as entity_ViewYouthReportState <<domain type>>
}
page_YouthAnnouncements --> client_AuthApi : invokes
client_AuthApi --> controller_ReportsController : calls
controller_ReportsController ..> request_YouthReportQuery : creates
request_YouthReportQuery --> handler_YouthReportQueryHandler : dispatched to
handler_YouthReportQueryHandler --> IAppDbContext : depends on
handler_YouthReportQueryHandler --> ICurrentUser : scopes by
handler_YouthReportQueryHandler --> entity_ViewYouthReportState : reads or changes
IAppDbContext o-- entity_ViewYouthReportState : persists
legend right
  Solid arrows show runtime collaboration.
  Dashed arrows show construction.
  Aggregation shows persistence ownership.
endlegend
@enduml
