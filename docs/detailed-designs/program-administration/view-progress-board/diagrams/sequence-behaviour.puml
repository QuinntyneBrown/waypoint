@startuml

title UML sequence behaviour — View the progress board
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Program administrator" as actor
box "Frontend — Portal application" #E0F2FE
  participant "SettingsNotifications" as page
  participant "PeopleApi" as client
end box
box "Backend — WordUp API application" #D1FADF
  participant "OrgSettingsController" as controller
end box
box "Backend — WordUp Application and Domain" #ECFDF3
  participant "ProgressBoardQueryHandler" as handler
  participant "Cohort" as entity
end box
box "Backend — WordUp Infrastructure" #FFF4E5
  database "Word Up database" as db
end box
actor -> page : Start view the progress board
page -> client : Build typed request
client -> controller : HTTPS request
controller -> controller : Authenticate and apply endpoint policy
controller -> handler : Send ProgressBoardQuery
handler -> db : Query authorized state
db --> handler : Current state
handler -> entity : Apply L2-ADMIN-004, L2-REPORT-003, L2-NFR-005, L2-NFR-009 feature r…
entity --> handler : Valid state transition or projection
handler -> db : Complete bounded projection
db --> handler : Commit or query result
handler --> controller : Typed result
controller --> client : HTTP response or ProblemDetails
client --> page : Feature result
page --> actor : Present view the progress board result
@enduml
