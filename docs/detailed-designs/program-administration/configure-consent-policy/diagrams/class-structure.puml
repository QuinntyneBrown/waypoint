@startuml
left to right direction
title UML class structure — Configure consent policy
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
package "Frontend — Portal application" {
  class "ConsentRequired" as page_ConsentRequired <<Angular component>> {
    +submit(): void
    +renderResult(): void
  }
  class "ConsentApi" as client_ConsentApi <<API client>> {
    +execute(request): Observable
  }
}
package "Backend — WordUp API application" {
  class "OrgSettingsController" as controller_OrgSettingsController <<controller>> {
    +PostAsync(request, cancellationToken): ActionResult
  }
}
package "Backend — WordUp Application" {
  class "GetOrgSettingsQuery" as request_GetOrgSettingsQuery <<record>>
  class "GetOrgSettingsQueryHandler" as handler_GetOrgSettingsQueryHandler <<handler>> {
    +Handle(request, cancellationToken): Result
  }
  interface IAppDbContext {
    +SaveChangesAsync(cancellationToken): int
  }
  interface ICurrentUser {
    +Id: Guid
    +Role: string
  }
}
package "Backend — WordUp Domain" {
  class "OrgSettings" as entity_OrgSettings <<domain type>>
}
page_ConsentRequired --> client_ConsentApi : invokes
client_ConsentApi --> controller_OrgSettingsController : calls
controller_OrgSettingsController ..> request_GetOrgSettingsQuery : creates
request_GetOrgSettingsQuery --> handler_GetOrgSettingsQueryHandler : dispatched to
handler_GetOrgSettingsQueryHandler --> IAppDbContext : depends on
handler_GetOrgSettingsQueryHandler --> ICurrentUser : scopes by
handler_GetOrgSettingsQueryHandler --> entity_OrgSettings : reads or changes
IAppDbContext o-- entity_OrgSettings : persists
legend right
  Solid arrows show runtime collaboration.
  Dashed arrows show construction.
  Aggregation shows persistence ownership.
endlegend
@enduml
