@startuml

title UML sequence behaviour — Configure the organization profile
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Program administrator" as actor
box "Frontend — Portal application" #E0F2FE
  participant "SettingsProfile" as page
  participant "ProfileApi" as client
end box
box "Backend — WordUp API application" #D1FADF
  participant "OrgSettingsController" as controller
end box
box "Backend — WordUp Application and Domain" #ECFDF3
  participant "GetOrgSettingsQueryHandler" as handler
  participant "OrgSettings" as entity
end box
box "Backend — WordUp Infrastructure" #FFF4E5
  database "Word Up database" as db
end box
actor -> page : Start configure the organization profile
page -> client : Build typed request
client -> controller : HTTPS request
controller -> controller : Authenticate and apply endpoint policy
controller -> handler : Send GetOrgSettingsQuery
handler -> db : Load and persist authorized state
db --> handler : Current state
handler -> entity : Apply L2-ADMIN-006, L2-AUTH-009, L2-CONSENT-003, L2-NFR-001 feature…
entity --> handler : Valid state transition or projection
handler -> db : Save changes in one unit of work
db --> handler : Commit or query result
handler --> controller : Typed result
controller --> client : HTTP response or ProblemDetails
client --> page : Feature result
page --> actor : Present configure the organization profile result
@enduml
