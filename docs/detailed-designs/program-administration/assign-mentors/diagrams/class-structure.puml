@startuml
left to right direction
title UML class structure — Assign mentors
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
package "Frontend — Portal application" {
  class "PeopleDirectory" as page_PeopleDirectory <<Angular component>> {
    +submit(): void
    +renderResult(): void
  }
  class "PeopleApi" as client_PeopleApi <<API client>> {
    +execute(request): Observable
  }
}
package "Backend — Waypoint API application" {
  class "OrgSettingsController" as controller_OrgSettingsController <<controller>> {
    +PostAsync(request, cancellationToken): ActionResult
  }
}
package "Backend — Waypoint Application" {
  class "AssignMentorCommand" as request_AssignMentorCommand <<record>>
  class "AssignMentorCommandHandler" as handler_AssignMentorCommandHandler <<handler>> {
    +Handle(request, cancellationToken): Result
  }
  interface IAppDbContext {
    +SaveChangesAsync(cancellationToken): int
  }
  interface ICurrentUser {
    +Id: Guid
    +Role: string
  }
}
package "Backend — Waypoint Domain" {
  class "CohortMentor" as entity_CohortMentor <<domain type>>
}
page_PeopleDirectory --> client_PeopleApi : invokes
client_PeopleApi --> controller_OrgSettingsController : calls
controller_OrgSettingsController ..> request_AssignMentorCommand : creates
request_AssignMentorCommand --> handler_AssignMentorCommandHandler : dispatched to
handler_AssignMentorCommandHandler --> IAppDbContext : depends on
handler_AssignMentorCommandHandler --> ICurrentUser : scopes by
handler_AssignMentorCommandHandler --> entity_CohortMentor : reads or changes
IAppDbContext o-- entity_CohortMentor : persists
legend right
  Solid arrows show runtime collaboration.
  Dashed arrows show construction.
  Aggregation shows persistence ownership.
endlegend
@enduml
