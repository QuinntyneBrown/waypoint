@startuml

title UML sequence behaviour — Search people
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Program administrator" as actor
box "Frontend — Portal application" #E0F2FE
  participant "PeopleDirectory" as page
  participant "PeopleService" as client
end box
box "Backend — Waypoint API application" #D1FADF
  participant "PeopleController" as controller
end box
box "Backend — Waypoint Application and Domain" #ECFDF3
  participant "ListPeopleQueryHandler" as handler
  participant "Cohort" as entity
end box
box "Backend — Waypoint Infrastructure" #FFF4E5
  database "Waypoint database" as db
end box
actor -> page : Start search people
page -> client : Build typed request
client -> controller : HTTPS request
controller -> controller : Authenticate and apply endpoint policy
controller -> handler : Send ListPeopleQuery
handler -> db : Load and persist authorized state
db --> handler : Current state
handler -> entity : Apply L2-ADMIN-001, L2-NFR-008, L2-NFR-009 feature rules
entity --> handler : Valid state transition or projection
handler -> db : Save changes in one unit of work
db --> handler : Commit or query result
handler --> controller : Typed result
controller --> client : HTTP response or ProblemDetails
client --> page : Feature result
page --> actor : Present search people result
@enduml
