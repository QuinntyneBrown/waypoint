@startuml

title UML sequence behaviour — Register volunteer interest
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Anonymous visitor" as actor
box "Frontend — Public Site application" #E0F2FE
  participant "VolunteerAttendance" as page
  participant "VolunteerService" as client
end box
box "Backend — Waypoint API application" #D1FADF
  participant "PublicController" as controller
end box
box "Backend — Waypoint Application and Domain" #ECFDF3
  participant "SubmitVolunteerSignupCommandHandler" as handler
  participant "VolunteerSignup" as entity
end box
box "Backend — Waypoint Infrastructure" #FFF4E5
  database "Waypoint database" as db
end box
actor -> page : Start register volunteer interest
page -> client : Build typed request
client -> controller : HTTPS request
controller -> controller : Authenticate and apply endpoint policy
controller -> handler : Send SubmitVolunteerSignupCommand
handler -> db : Load and persist authorized state
db --> handler : Current state
handler -> entity : Apply L2-PUB-003, L2-NFR-001, L2-CONSENT-004 feature rules
entity --> handler : Valid state transition or projection
handler -> db : Save changes in one unit of work
db --> handler : Commit or query result
handler --> controller : Typed result
controller --> client : HTTP response or ProblemDetails
client --> page : Feature result
page --> actor : Present register volunteer interest result
@enduml
