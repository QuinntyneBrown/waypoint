@startuml
left to right direction
title UML class structure — Browse current cohorts
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
package "Frontend — Public Site application" {
  class "Programs" as page_Programs <<Angular component>> {
    +load(): void
    +renderResult(): void
  }
  class "PublicSiteService" as client_PublicSiteApi <<API client>> {
    +get(request): Observable
  }
}
package "Backend — Waypoint API application" {
  class "PublicController" as controller_PublicController <<controller>> {
    +GetAsync(request, cancellationToken): ActionResult
  }
}
package "Backend — Waypoint Application" {
  class "GetPublicContentQuery" as request_GetPublicContentQuery <<record>>
  class "GetPublicContentQueryHandler" as handler_GetPublicContentQueryHandler <<handler>> {
    +Handle(request, cancellationToken): Result
  }
  interface IAppDbContext {
    +SaveChangesAsync(cancellationToken): int
  }
  interface ICurrentUser {
    +Id: Guid
    +Role: string
  }
}
package "Backend — Waypoint Domain" {
  class "BrowseCurrentCohortsState" as entity_BrowseCurrentCohortsState <<domain type>>
}
page_Programs --> client_PublicSiteApi : invokes
client_PublicSiteApi --> controller_PublicController : calls
controller_PublicController ..> request_GetPublicContentQuery : creates
request_GetPublicContentQuery --> handler_GetPublicContentQueryHandler : dispatched to
handler_GetPublicContentQueryHandler --> IAppDbContext : depends on
handler_GetPublicContentQueryHandler --> ICurrentUser : scopes by
handler_GetPublicContentQueryHandler --> entity_BrowseCurrentCohortsState : reads or changes
IAppDbContext o-- entity_BrowseCurrentCohortsState : persists
legend right
  Solid arrows show runtime collaboration.
  Dashed arrows show construction.
  Aggregation shows persistence ownership.
endlegend
@enduml
