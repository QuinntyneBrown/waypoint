@startuml
left to right direction
title UML class structure — View an upcoming schedule
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
package "Frontend — Portal application" {
  class "VolunteerSchedule" as page_VolunteerSchedule <<Angular component>> {
    +load(): void
    +renderResult(): void
  }
  class "VolunteerService" as client_VolunteerApi <<API client>> {
    +get(request): Observable
  }
}
package "Backend — Waypoint API application" {
  class "VolunteerController" as controller_VolunteerController <<controller>> {
    +GetAsync(request, cancellationToken): ActionResult
  }
}
package "Backend — Waypoint Application" {
  class "VolunteerScheduleQuery" as request_VolunteerScheduleQuery <<record>>
  class "VolunteerScheduleQueryHandler" as handler_VolunteerScheduleQueryHandler <<handler>> {
    +Handle(request, cancellationToken): Result
  }
  interface IAppDbContext {
    +SaveChangesAsync(cancellationToken): int
  }
  interface ICurrentUser {
    +Id: Guid
    +Role: string
  }
}
package "Backend — Waypoint Domain" {
  class "ViewUpcomingScheduleState" as entity_ViewUpcomingScheduleState <<domain type>>
}
page_VolunteerSchedule --> client_VolunteerApi : invokes
client_VolunteerApi --> controller_VolunteerController : calls
controller_VolunteerController ..> request_VolunteerScheduleQuery : creates
request_VolunteerScheduleQuery --> handler_VolunteerScheduleQueryHandler : dispatched to
handler_VolunteerScheduleQueryHandler --> IAppDbContext : depends on
handler_VolunteerScheduleQueryHandler --> ICurrentUser : scopes by
handler_VolunteerScheduleQueryHandler --> entity_ViewUpcomingScheduleState : reads or changes
IAppDbContext o-- entity_ViewUpcomingScheduleState : persists
legend right
  Solid arrows show runtime collaboration.
  Dashed arrows show construction.
  Aggregation shows persistence ownership.
endlegend
@enduml
