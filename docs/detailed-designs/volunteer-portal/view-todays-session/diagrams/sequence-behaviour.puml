@startuml

title UML sequence behaviour — View today's session
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Volunteer" as actor
box "Frontend — Portal application" #E0F2FE
  participant "VolunteerToday" as page
  participant "VolunteerService" as client
end box
box "Backend — Waypoint API application" #D1FADF
  participant "VolunteerController" as controller
end box
box "Backend — Waypoint Application and Domain" #ECFDF3
  participant "VolunteerTodayQueryHandler" as handler
  participant "ViewTodaysSessionState" as entity
end box
box "Backend — Waypoint Infrastructure" #FFF4E5
  database "Waypoint database" as db
end box
actor -> page : Start view today's session
page -> client : Build typed request
client -> controller : HTTPS request
controller -> controller : Authenticate and apply endpoint policy
controller -> handler : Send VolunteerTodayQuery
handler -> db : Query authorized state
db --> handler : Current state
handler -> entity : Apply L2-VOLUNTEER-001, L2-AUTH-010 feature rules
entity --> handler : Valid state transition or projection
handler -> db : Complete bounded projection
db --> handler : Commit or query result
handler --> controller : Typed result
controller --> client : HTTP response or ProblemDetails
client --> page : Feature result
page --> actor : Present view today's session result
@enduml
