@startuml
left to right direction
title UML class structure — Record session attendance
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
package "Frontend — Portal application" {
  class "VolunteerAttendance" as page_VolunteerAttendance <<Angular component>> {
    +submit(): void
    +renderResult(): void
  }
  class "VolunteerApi" as client_VolunteerApi <<API client>> {
    +execute(request): Observable
  }
}
package "Backend — Waypoint API application" {
  class "VolunteerController" as controller_VolunteerController <<controller>> {
    +PostAsync(request, cancellationToken): ActionResult
  }
}
package "Backend — Waypoint Application" {
  class "VolunteerTodayQuery" as request_VolunteerTodayQuery <<record>>
  class "VolunteerTodayQueryHandler" as handler_VolunteerTodayQueryHandler <<handler>> {
    +Handle(request, cancellationToken): Result
  }
  interface IAppDbContext {
    +SaveChangesAsync(cancellationToken): int
  }
  interface ICurrentUser {
    +Id: Guid
    +Role: string
  }
}
package "Backend — Waypoint Domain" {
  class "RecordSessionAttendanceState" as entity_RecordSessionAttendanceState <<domain type>>
}
page_VolunteerAttendance --> client_VolunteerApi : invokes
client_VolunteerApi --> controller_VolunteerController : calls
controller_VolunteerController ..> request_VolunteerTodayQuery : creates
request_VolunteerTodayQuery --> handler_VolunteerTodayQueryHandler : dispatched to
handler_VolunteerTodayQueryHandler --> IAppDbContext : depends on
handler_VolunteerTodayQueryHandler --> ICurrentUser : scopes by
handler_VolunteerTodayQueryHandler --> entity_RecordSessionAttendanceState : reads or changes
IAppDbContext o-- entity_RecordSessionAttendanceState : persists
legend right
  Solid arrows show runtime collaboration.
  Dashed arrows show construction.
  Aggregation shows persistence ownership.
endlegend
@enduml
