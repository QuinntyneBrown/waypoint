@startuml

title UML sequence behaviour — Record session attendance
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Volunteer" as actor
box "Frontend — Portal application" #E0F2FE
  participant "SessionPersistence" as page
  participant "VolunteerApi" as client
end box
box "Backend — WordUp API application" #D1FADF
  participant "VolunteerController" as controller
end box
box "Backend — WordUp Application and Domain" #ECFDF3
  participant "VolunteerTodayQueryHandler" as handler
  participant "RecordSessionAttendanceState" as entity
end box
box "Backend — WordUp Infrastructure" #FFF4E5
  database "Word Up database" as db
end box
actor -> page : Start record session attendance
page -> client : Build typed request
client -> controller : HTTPS request
controller -> controller : Authenticate and apply endpoint policy
controller -> handler : Send VolunteerTodayQuery
handler -> db : Load and persist authorized state
db --> handler : Current state
handler -> entity : Apply L2-VOLUNTEER-001, L2-NFR-004, L2-AUTH-010, L2-PLATFORM-006 fe…
entity --> handler : Valid state transition or projection
handler -> db : Save changes in one unit of work
db --> handler : Commit or query result
handler --> controller : Typed result
controller --> client : HTTP response or ProblemDetails
client --> page : Feature result
page --> actor : Present record session attendance result
@enduml
