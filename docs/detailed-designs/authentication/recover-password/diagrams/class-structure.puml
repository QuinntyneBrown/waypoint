@startuml
left to right direction
title UML class structure — Recover a password
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
package "Frontend — Portal application" {
  class "ResetPassword" as page_ResetPassword <<Angular component>> {
    +submit(): void
    +renderResult(): void
  }
  class "PasswordResetApi" as client_PasswordResetApi <<API client>> {
    +execute(request): Observable
  }
}
package "Backend — WordUp API application" {
  class "PasswordResetController" as controller_PasswordResetController <<controller>> {
    +PostAsync(request, cancellationToken): ActionResult
  }
}
package "Backend — WordUp Application" {
  class "ResetPasswordCommand" as request_ResetPasswordCommand <<record>>
  class "ResetPasswordCommandHandler" as handler_ResetPasswordCommandHandler <<handler>> {
    +Handle(request, cancellationToken): Result
  }
  interface IAppDbContext {
    +SaveChangesAsync(cancellationToken): int
  }
  interface ICurrentUser {
    +Id: Guid
    +Role: string
  }
}
package "Backend — WordUp Domain" {
  class "PasswordResetToken" as entity_PasswordResetToken <<domain type>>
}
page_ResetPassword --> client_PasswordResetApi : invokes
client_PasswordResetApi --> controller_PasswordResetController : calls
controller_PasswordResetController ..> request_ResetPasswordCommand : creates
request_ResetPasswordCommand --> handler_ResetPasswordCommandHandler : dispatched to
handler_ResetPasswordCommandHandler --> IAppDbContext : depends on
handler_ResetPasswordCommandHandler --> ICurrentUser : scopes by
handler_ResetPasswordCommandHandler --> entity_PasswordResetToken : reads or changes
IAppDbContext o-- entity_PasswordResetToken : persists
legend right
  Solid arrows show runtime collaboration.
  Dashed arrows show construction.
  Aggregation shows persistence ownership.
endlegend
@enduml
