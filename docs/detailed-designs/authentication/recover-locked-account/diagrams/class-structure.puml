@startuml
left to right direction
title UML class structure — Recover a locked account
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
package "Frontend — Portal application" {
  class "AccountLocked" as page_AccountLocked <<Angular component>> {
    +submit(): void
    +renderResult(): void
  }
  class "AuthApi" as client_AuthApi <<API client>> {
    +execute(request): Observable
  }
}
package "Backend — WordUp API application" {
  class "AuthController" as controller_AuthController <<controller>> {
    +PostAsync(request, cancellationToken): ActionResult
  }
}
package "Backend — WordUp Application" {
  class "RecoverLockedAccountCommand" as request_RecoverLockedAccountCommand <<record>>
  class "RecoverLockedAccountCommandHandler" as handler_RecoverLockedAccountCommandHandler <<handler>> {
    +Handle(request, cancellationToken): Result
  }
  interface IAppDbContext {
    +SaveChangesAsync(cancellationToken): int
  }
  interface ICurrentUser {
    +Id: Guid
    +Role: string
  }
}
package "Backend — WordUp Domain" {
  class "PasswordResetToken" as entity_PasswordResetToken <<domain type>>
}
page_AccountLocked --> client_AuthApi : invokes
client_AuthApi --> controller_AuthController : calls
controller_AuthController ..> request_RecoverLockedAccountCommand : creates
request_RecoverLockedAccountCommand --> handler_RecoverLockedAccountCommandHandler : dispatched to
handler_RecoverLockedAccountCommandHandler --> IAppDbContext : depends on
handler_RecoverLockedAccountCommandHandler --> ICurrentUser : scopes by
handler_RecoverLockedAccountCommandHandler --> entity_PasswordResetToken : reads or changes
IAppDbContext o-- entity_PasswordResetToken : persists
legend right
  Solid arrows show runtime collaboration.
  Dashed arrows show construction.
  Aggregation shows persistence ownership.
endlegend
@enduml
