@startuml

title UML sequence behaviour — Recover a locked account
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Account holder" as actor
box "Frontend — Portal application" #E0F2FE
  participant "AccountLocked" as page
  participant "AuthApi" as client
end box
box "Backend — WordUp API application" #D1FADF
  participant "AuthController" as controller
end box
box "Backend — WordUp Application and Domain" #ECFDF3
  participant "RecoverLockedAccountCommandHandler" as handler
  participant "PasswordResetToken" as entity
end box
box "Backend — WordUp Infrastructure" #FFF4E5
  database "Word Up database" as db
end box
actor -> page : Start recover a locked account
page -> client : Build typed request
client -> controller : HTTPS request
controller -> controller : Authenticate and apply endpoint policy
controller -> handler : Send RecoverLockedAccountCommand
handler -> db : Load and persist authorized state
db --> handler : Current state
handler -> entity : Apply L2-AUTH-006, L2-AUTH-001, L2-CONSENT-003 feature rules
entity --> handler : Valid state transition or projection
handler -> db : Save changes in one unit of work
db --> handler : Commit or query result
handler --> controller : Typed result
controller --> client : HTTP response or ProblemDetails
client --> page : Feature result
page --> actor : Present recover a locked account result
@enduml
