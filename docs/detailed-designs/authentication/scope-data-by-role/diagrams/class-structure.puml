@startuml
left to right direction
title UML class structure — Scope data by role
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
package "Frontend — Portal application" {
  class "AuthStore" as page_AuthStore <<Angular component>> {
    +submit(): void
    +renderResult(): void
  }
  class "AuthApi" as client_AuthApi <<API client>> {
    +execute(request): Observable
  }
}
package "Backend — WordUp API application" {
  class "AuthController" as controller_AuthController <<controller>> {
    +PostAsync(request, cancellationToken): ActionResult
  }
}
package "Backend — WordUp Application" {
  class "ScopeDataByRoleCommand" as request_ScopeDataByRoleCommand <<record>>
  class "ScopeDataByRoleCommandHandler" as handler_ScopeDataByRoleCommandHandler <<handler>> {
    +Handle(request, cancellationToken): Result
  }
  interface IAppDbContext {
    +SaveChangesAsync(cancellationToken): int
  }
  interface ICurrentUser {
    +Id: Guid
    +Role: string
  }
}
package "Backend — WordUp Domain" {
  class "Invitation" as entity_Invitation <<domain type>>
}
page_AuthStore --> client_AuthApi : invokes
client_AuthApi --> controller_AuthController : calls
controller_AuthController ..> request_ScopeDataByRoleCommand : creates
request_ScopeDataByRoleCommand --> handler_ScopeDataByRoleCommandHandler : dispatched to
handler_ScopeDataByRoleCommandHandler --> IAppDbContext : depends on
handler_ScopeDataByRoleCommandHandler --> ICurrentUser : scopes by
handler_ScopeDataByRoleCommandHandler --> entity_Invitation : reads or changes
IAppDbContext o-- entity_Invitation : persists
legend right
  Solid arrows show runtime collaboration.
  Dashed arrows show construction.
  Aggregation shows persistence ownership.
endlegend
@enduml
