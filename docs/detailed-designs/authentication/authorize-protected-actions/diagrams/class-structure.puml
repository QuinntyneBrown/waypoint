@startuml
left to right direction
title UML class structure — Authorize protected actions
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
package "Frontend — Portal application" {
  class "AuthStore" as page_AuthStore <<Angular component>> {
    +submit(): void
    +renderResult(): void
  }
  class "AuthApi" as client_AuthApi <<API client>> {
    +execute(request): Observable
  }
}
package "Backend — Waypoint API application" {
  class "AuthController" as controller_AuthController <<controller>> {
    +PostAsync(request, cancellationToken): ActionResult
  }
}
package "Backend — Waypoint Application" {
  class "AuthorizeProtectedActionsCommand" as request_AuthorizeProtectedActionsCommand <<record>>
  class "AuthorizeProtectedActionsCommandHandler" as handler_AuthorizeProtectedActionsCommandHandler <<handler>> {
    +Handle(request, cancellationToken): Result
  }
  interface IAppDbContext {
    +SaveChangesAsync(cancellationToken): int
  }
  interface ICurrentUser {
    +Id: Guid
    +Role: string
  }
}
package "Backend — Waypoint Domain" {
  class "AuthorizeProtectedActionsState" as entity_AuthorizeProtectedActionsState <<domain type>>
}
page_AuthStore --> client_AuthApi : invokes
client_AuthApi --> controller_AuthController : calls
controller_AuthController ..> request_AuthorizeProtectedActionsCommand : creates
request_AuthorizeProtectedActionsCommand --> handler_AuthorizeProtectedActionsCommandHandler : dispatched to
handler_AuthorizeProtectedActionsCommandHandler --> IAppDbContext : depends on
handler_AuthorizeProtectedActionsCommandHandler --> ICurrentUser : scopes by
handler_AuthorizeProtectedActionsCommandHandler --> entity_AuthorizeProtectedActionsState : reads or changes
IAppDbContext o-- entity_AuthorizeProtectedActionsState : persists
legend right
  Solid arrows show runtime collaboration.
  Dashed arrows show construction.
  Aggregation shows persistence ownership.
endlegend
@enduml
