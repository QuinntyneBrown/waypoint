@startuml
left to right direction
title UML class structure — Issue invitations
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
package "Frontend — Portal application" {
  class "AuthStore" as page_AuthStore <<Angular component>> {
    +submit(): void
    +renderResult(): void
  }
  class "AuthApi" as client_AuthApi <<API client>> {
    +execute(request): Observable
  }
}
package "Backend — Waypoint API application" {
  class "InvitationsController" as controller_InvitationsController <<controller>> {
    +PostAsync(request, cancellationToken): ActionResult
  }
}
package "Backend — Waypoint Application" {
  class "ResendInvitationCommand" as request_ResendInvitationCommand <<record>>
  class "ResendInvitationCommandHandler" as handler_ResendInvitationCommandHandler <<handler>> {
    +Handle(request, cancellationToken): Result
  }
  interface IAppDbContext {
    +SaveChangesAsync(cancellationToken): int
  }
  interface ICurrentUser {
    +Id: Guid
    +Role: string
  }
}
package "Backend — Waypoint Domain" {
  class "Invitation" as entity_Invitation <<domain type>>
}
page_AuthStore --> client_AuthApi : invokes
client_AuthApi --> controller_InvitationsController : calls
controller_InvitationsController ..> request_ResendInvitationCommand : creates
request_ResendInvitationCommand --> handler_ResendInvitationCommandHandler : dispatched to
handler_ResendInvitationCommandHandler --> IAppDbContext : depends on
handler_ResendInvitationCommandHandler --> ICurrentUser : scopes by
handler_ResendInvitationCommandHandler --> entity_Invitation : reads or changes
IAppDbContext o-- entity_Invitation : persists
legend right
  Solid arrows show runtime collaboration.
  Dashed arrows show construction.
  Aggregation shows persistence ownership.
endlegend
@enduml
