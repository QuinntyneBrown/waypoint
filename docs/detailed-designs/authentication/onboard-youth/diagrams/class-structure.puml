@startuml
left to right direction
title UML class structure — Onboard a youth
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
package "Frontend — Portal application" {
  class "YouthNotifications" as page_YouthNotifications <<Angular component>> {
    +submit(): void
    +renderResult(): void
  }
  class "OnboardingApi" as client_OnboardingApi <<API client>> {
    +execute(request): Observable
  }
}
package "Backend — Waypoint API application" {
  class "OnboardingController" as controller_OnboardingController <<controller>> {
    +PostAsync(request, cancellationToken): ActionResult
  }
}
package "Backend — Waypoint Application" {
  class "SkipOnboardingCommand" as request_SkipOnboardingCommand <<record>>
  class "SkipOnboardingCommandHandler" as handler_SkipOnboardingCommandHandler <<handler>> {
    +Handle(request, cancellationToken): Result
  }
  interface IAppDbContext {
    +SaveChangesAsync(cancellationToken): int
  }
  interface ICurrentUser {
    +Id: Guid
    +Role: string
  }
}
package "Backend — Waypoint Domain" {
  class "User" as entity_User <<domain type>>
}
page_YouthNotifications --> client_OnboardingApi : invokes
client_OnboardingApi --> controller_OnboardingController : calls
controller_OnboardingController ..> request_SkipOnboardingCommand : creates
request_SkipOnboardingCommand --> handler_SkipOnboardingCommandHandler : dispatched to
handler_SkipOnboardingCommandHandler --> IAppDbContext : depends on
handler_SkipOnboardingCommandHandler --> ICurrentUser : scopes by
handler_SkipOnboardingCommandHandler --> entity_User : reads or changes
IAppDbContext o-- entity_User : persists
legend right
  Solid arrows show runtime collaboration.
  Dashed arrows show construction.
  Aggregation shows persistence ownership.
endlegend
@enduml
