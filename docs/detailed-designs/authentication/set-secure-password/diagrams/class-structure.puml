@startuml
left to right direction
title UML class structure — Set a secure password
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
package "Frontend — Portal application" {
  class "ForgotPassword" as page_ForgotPassword <<Angular component>> {
    +submit(): void
    +renderResult(): void
  }
  class "PasswordResetApi" as client_PasswordResetApi <<API client>> {
    +execute(request): Observable
  }
}
package "Backend — Waypoint API application" {
  class "PasswordResetController" as controller_PasswordResetController <<controller>> {
    +PostAsync(request, cancellationToken): ActionResult
  }
}
package "Backend — Waypoint Application" {
  class "ForgotPasswordCommand" as request_ForgotPasswordCommand <<record>>
  class "ForgotPasswordCommandHandler" as handler_ForgotPasswordCommandHandler <<handler>> {
    +Handle(request, cancellationToken): Result
  }
  interface IAppDbContext {
    +SaveChangesAsync(cancellationToken): int
  }
  interface ICurrentUser {
    +Id: Guid
    +Role: string
  }
}
package "Backend — Waypoint Domain" {
  class "PasswordResetToken" as entity_PasswordResetToken <<domain type>>
}
page_ForgotPassword --> client_PasswordResetApi : invokes
client_PasswordResetApi --> controller_PasswordResetController : calls
controller_PasswordResetController ..> request_ForgotPasswordCommand : creates
request_ForgotPasswordCommand --> handler_ForgotPasswordCommandHandler : dispatched to
handler_ForgotPasswordCommandHandler --> IAppDbContext : depends on
handler_ForgotPasswordCommandHandler --> ICurrentUser : scopes by
handler_ForgotPasswordCommandHandler --> entity_PasswordResetToken : reads or changes
IAppDbContext o-- entity_PasswordResetToken : persists
legend right
  Solid arrows show runtime collaboration.
  Dashed arrows show construction.
  Aggregation shows persistence ownership.
endlegend
@enduml
