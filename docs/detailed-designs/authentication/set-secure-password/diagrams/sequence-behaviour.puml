@startuml

title UML sequence behaviour — Set a secure password
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Account holder" as actor
box "Frontend — Portal application" #E0F2FE
  participant "ForgotPassword" as page
  participant "PasswordResetService" as client
end box
box "Backend — Waypoint API application" #D1FADF
  participant "PasswordResetController" as controller
end box
box "Backend — Waypoint Application and Domain" #ECFDF3
  participant "ForgotPasswordCommandHandler" as handler
  participant "PasswordResetToken" as entity
end box
box "Backend — Waypoint Infrastructure" #FFF4E5
  database "Waypoint database" as db
end box
actor -> page : Start set a secure password
page -> client : Build typed request
client -> controller : HTTPS request
controller -> controller : Authenticate and apply endpoint policy
controller -> handler : Send ForgotPasswordCommand
handler -> db : Load and persist authorized state
db --> handler : Current state
handler -> entity : Apply L2-AUTH-008 feature rules
entity --> handler : Valid state transition or projection
handler -> db : Save changes in one unit of work
db --> handler : Commit or query result
handler --> controller : Typed result
controller --> client : HTTP response or ProblemDetails
client --> page : Feature result
page --> actor : Present set a secure password result
@enduml
