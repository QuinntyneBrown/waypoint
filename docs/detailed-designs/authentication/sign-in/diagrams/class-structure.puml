@startuml
left to right direction
title UML class structure — Sign in
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
package "Frontend — Portal application" {
  class "SignIn" as page_SignIn <<Angular component>> {
    +submit(): void
    +renderResult(): void
  }
  class "AuthApi" as client_AuthApi <<API client>> {
    +execute(request): Observable
  }
}
package "Backend — Waypoint API application" {
  class "AuthController" as controller_AuthController <<controller>> {
    +PostAsync(request, cancellationToken): ActionResult
  }
}
package "Backend — Waypoint Application" {
  class "SignInCommand" as request_SignInCommand <<record>>
  class "SignInCommandHandler" as handler_SignInCommandHandler <<handler>> {
    +Handle(request, cancellationToken): Result
  }
  interface IAppDbContext {
    +SaveChangesAsync(cancellationToken): int
  }
  interface ICurrentUser {
    +Id: Guid
    +Role: string
  }
}
package "Backend — Waypoint Domain" {
  class "User" as entity_User <<domain type>>
}
page_SignIn --> client_AuthApi : invokes
client_AuthApi --> controller_AuthController : calls
controller_AuthController ..> request_SignInCommand : creates
request_SignInCommand --> handler_SignInCommandHandler : dispatched to
handler_SignInCommandHandler --> IAppDbContext : depends on
handler_SignInCommandHandler --> ICurrentUser : scopes by
handler_SignInCommandHandler --> entity_User : reads or changes
IAppDbContext o-- entity_User : persists
legend right
  Solid arrows show runtime collaboration.
  Dashed arrows show construction.
  Aggregation shows persistence ownership.
endlegend
@enduml
