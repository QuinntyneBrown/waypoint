@startuml
!include <C4/C4_Component>
LAYOUT_LEFT_RIGHT()
title C4 level 3 — Manage pending invitations — components
System_Boundary(wordup, "Word Up software system") {
  Container_Boundary(frontend, "Frontend") {
    Container_Boundary(frontend_app, "Portal application") {
      Component(page, "AuthStore", "Angular page component", "Owns feature interaction state and presentation")
      Component(client, "AuthApi", "Typed API client", "Calls the feature API with typed requests and results")
    }
  }
  Container_Boundary(backend, "Backend") {
    Container_Boundary(api_app, "WordUp API application") {
      Component(controller, "InvitationsController", "API controller", "Applies transport policy and maps requests")
    }
    Container_Boundary(application, "WordUp Application") {
      Component(request, "RevokeInvitationCommand", "MediatR request", "Represents the application use case")
      Component(handler, "RevokeInvitationCommandHandler", "MediatR handler", "Coordinates authorized feature behavior")
    }
    Container_Boundary(domain, "WordUp Domain") {
      Component(entity, "Invitation", "Domain type", "Holds feature state and invariants")
    }
    Container_Boundary(infrastructure, "WordUp Infrastructure") {
      Component(persistence, "AppDbContext", "EF Core adapter", "Queries and persists authoritative state")
    }
  }
}
Rel(page, client, "Calls")
Rel(client, controller, "Calls", "HTTPS JSON")
Rel(controller, request, "Constructs")
Rel(controller, handler, "Sends through MediatR")
Rel(handler, entity, "Reads or changes")
Rel(handler, persistence, "Queries or persists")
Rel(persistence, entity, "Maps")
SHOW_LEGEND()
@enduml
