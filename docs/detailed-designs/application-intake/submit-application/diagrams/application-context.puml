@startuml
!pragma layout smetana
left to right direction
title Application Context view\nV-APP-INTAKE-SUBMIT-APPLICATION

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam rectangleBorderColor #334155
skinparam rectangleFontColor #0F172A
skinparam ArrowColor #64748B

rectangle "Word Up software system\n<<entity of interest>>" as word_up #F3F4F6 {
  rectangle "Public Site application\n<<Angular SSR application>>" as app_public #E0F2FE {
    rectangle "Application Intake subsystem" as subsystem_public #F0F9FF {
      rectangle "Submit an application\n<<feature-slice contribution>>" as feature_public #FEF3C7
    }
  }
  rectangle "WordUp API application\n<<ASP.NET Core application>>" as app_api #DCFCE7 {
    rectangle "Application Intake subsystem" as subsystem_api #F0FDF4 {
      rectangle "Submit an application\n<<feature-slice contribution>>" as feature_api #FEF3C7
    }
  }
  app_public -[hidden]right-> app_api
}

legend bottom
|= Notation |= Meaning |
| Grey outer rectangle | Word Up software system, the entity of interest |
| Blue application rectangle | Angular application |
| Green application rectangle | ASP.NET Core application |
| Pale inner rectangle | Subsystem boundary within an application |
| Amber rectangle | Feature-slice contribution |
| Rectangle nesting | Containment |
endlegend

caption Figure 1 - Submit an application application context (VC-APP-INTAKE-SUBMIT-APPLICATION)
@enduml
