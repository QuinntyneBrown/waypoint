@startuml

title UML sequence behaviour — Inspect and export the audit log
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Program administrator" as actor
box "Frontend — Portal application" #E0F2FE
  participant "ConsentRequired" as page
  participant "ConsentService" as client
end box
box "Backend — Waypoint API application" #D1FADF
  participant "AuditController" as controller
end box
box "Backend — Waypoint Application and Domain" #ECFDF3
  participant "AuditLogQueryHandler" as handler
  participant "AuditEntry" as entity
end box
box "Backend — Waypoint Infrastructure" #FFF4E5
  database "Waypoint database" as db
end box
actor -> page : Start inspect and export the audit log
page -> client : Build typed request
client -> controller : HTTPS request
controller -> controller : Authenticate and apply endpoint policy
controller -> handler : Send AuditLogQuery
handler -> db : Query authorized state
db --> handler : Current state
handler -> entity : Apply L2-CONSENT-003, L2-REPORT-003 feature rules
entity --> handler : Valid state transition or projection
handler -> db : Complete bounded projection
db --> handler : Commit or query result
handler --> controller : Typed result
controller --> client : HTTP response or ProblemDetails
client --> page : Feature result
page --> actor : Present inspect and export the audit log result
@enduml
