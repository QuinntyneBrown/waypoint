@startuml

title UML sequence behaviour — Inspect and export the audit log
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Program administrator" as actor
box "Frontend — Portal application" #E0F2FE
  participant "ConsentRequired" as page
  participant "ConsentApi" as client
end box
box "Backend — WordUp API application" #D1FADF
  participant "AuditController" as controller
end box
box "Backend — WordUp Application and Domain" #ECFDF3
  participant "AuditLogQueryHandler" as handler
  participant "AuditEntry" as entity
end box
box "Backend — WordUp Infrastructure" #FFF4E5
  database "Word Up database" as db
end box
actor -> page : A program administrator starts the inspect and export the audit log interac…
page -> client : Build typed request
client -> controller : HTTPS request
controller -> controller : Authenticate and apply endpoint policy
controller -> handler : Send AuditLogQuery
handler -> db : Query authorized state
db --> handler : Current state
handler -> entity : The frontend application captures the interaction and sends a typed request to the Word…
entity --> handler : Valid state transition or projection
handler -> db : Save changes when the request changes state
db --> handler : Commit or query result
handler --> controller : Typed result
controller --> client : HTTP response or ProblemDetails
client --> page : Feature result
page --> actor : The frontend application presents an authorized and bounded inspect and exp…
@enduml
