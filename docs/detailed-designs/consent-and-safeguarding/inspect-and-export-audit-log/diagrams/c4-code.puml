@startuml
!include <C4/C4_Component>
LAYOUT_LEFT_RIGHT()
title C4 level 4 — Inspect and export the audit log — code elements
System_Boundary(wordup, "Word Up software system") {
  Container_Boundary(frontend, "Frontend") {
    Container_Boundary(frontend_app, "Portal application") {
      Component(page, "ConsentRequired", "Angular component", "Feature page code element")
      Component(client, "ConsentApi", "TypeScript API client", "Typed API boundary code element")
    }
  }
  Container_Boundary(backend, "Backend") {
    Container_Boundary(api_app, "WordUp API application") {
      Component(controller, "AuditController", "C# controller", "HTTP endpoint code element")
    }
    Container_Boundary(application, "WordUp Application") {
      Component(request, "AuditLogQuery", "C# request record", "Application request code element")
      Component(handler, "AuditLogQueryHandler", "C# handler class", "Application handler code element")
      Component(dbport, "IAppDbContext", "C# interface", "Persistence port")
      Component(current, "ICurrentUser", "C# interface", "Current-user port")
    }
    Container_Boundary(domain, "WordUp Domain") {
      Component(entity, "AuditEntry", "C# domain type", "Feature domain code element")
    }
  }
}
Rel(page, client, "Invokes")
Rel(client, controller, "Calls")
Rel(controller, request, "Constructs")
Rel(request, handler, "Dispatched to")
Rel(handler, dbport, "Depends on")
Rel(handler, current, "Scopes by")
Rel(handler, entity, "Reads or changes")
SHOW_LEGEND()
@enduml
