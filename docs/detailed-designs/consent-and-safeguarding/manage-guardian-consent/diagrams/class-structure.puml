@startuml
left to right direction
title UML class structure — Manage guardian consent
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
package "Frontend — Portal application" {
  class "ConsentRequired" as page_ConsentRequired <<Angular component>> {
    +submit(): void
    +renderResult(): void
  }
  class "ConsentApi" as client_ConsentApi <<API client>> {
    +execute(request): Observable
  }
}
package "Backend — WordUp API application" {
  class "ConsentController" as controller_ConsentController <<controller>> {
    +PostAsync(request, cancellationToken): ActionResult
  }
}
package "Backend — WordUp Application" {
  class "CaptureConsentCommand" as request_CaptureConsentCommand <<record>>
  class "CaptureConsentCommandHandler" as handler_CaptureConsentCommandHandler <<handler>> {
    +Handle(request, cancellationToken): Result
  }
  interface IAppDbContext {
    +SaveChangesAsync(cancellationToken): int
  }
  interface ICurrentUser {
    +Id: Guid
    +Role: string
  }
}
package "Backend — WordUp Domain" {
  class "GuardianConsent" as entity_GuardianConsent <<domain type>>
}
page_ConsentRequired --> client_ConsentApi : invokes
client_ConsentApi --> controller_ConsentController : calls
controller_ConsentController ..> request_CaptureConsentCommand : creates
request_CaptureConsentCommand --> handler_CaptureConsentCommandHandler : dispatched to
handler_CaptureConsentCommandHandler --> IAppDbContext : depends on
handler_CaptureConsentCommandHandler --> ICurrentUser : scopes by
handler_CaptureConsentCommandHandler --> entity_GuardianConsent : reads or changes
IAppDbContext o-- entity_GuardianConsent : persists
legend right
  Solid arrows show runtime collaboration.
  Dashed arrows show construction.
  Aggregation shows persistence ownership.
endlegend
@enduml
