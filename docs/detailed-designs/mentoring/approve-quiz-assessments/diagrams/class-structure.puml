@startuml
left to right direction
title UML class structure — Approve quiz assessments
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
package "Frontend — Portal application" {
  class "YouthAnnouncements" as page_YouthAnnouncements <<Angular component>> {
    +submit(): void
    +renderResult(): void
  }
  class "MentoringApi" as client_MentoringApi <<API client>> {
    +execute(request): Observable
  }
}
package "Backend — WordUp API application" {
  class "QuizApprovalController" as controller_QuizApprovalController <<controller>> {
    +PostAsync(request, cancellationToken): ActionResult
  }
}
package "Backend — WordUp Application" {
  class "ApproveAllQuizAttemptsCommand" as request_ApproveAllQuizAttemptsCommand <<record>>
  class "ApproveAllQuizAttemptsCommandHandler" as handler_ApproveAllQuizAttemptsCommandHandler <<handler>> {
    +Handle(request, cancellationToken): Result
  }
  interface IAppDbContext {
    +SaveChangesAsync(cancellationToken): int
  }
  interface ICurrentUser {
    +Id: Guid
    +Role: string
  }
}
package "Backend — WordUp Domain" {
  class "CompetencyAssessment" as entity_CompetencyAssessment <<domain type>>
}
page_YouthAnnouncements --> client_MentoringApi : invokes
client_MentoringApi --> controller_QuizApprovalController : calls
controller_QuizApprovalController ..> request_ApproveAllQuizAttemptsCommand : creates
request_ApproveAllQuizAttemptsCommand --> handler_ApproveAllQuizAttemptsCommandHandler : dispatched to
handler_ApproveAllQuizAttemptsCommandHandler --> IAppDbContext : depends on
handler_ApproveAllQuizAttemptsCommandHandler --> ICurrentUser : scopes by
handler_ApproveAllQuizAttemptsCommandHandler --> entity_CompetencyAssessment : reads or changes
IAppDbContext o-- entity_CompetencyAssessment : persists
legend right
  Solid arrows show runtime collaboration.
  Dashed arrows show construction.
  Aggregation shows persistence ownership.
endlegend
@enduml
