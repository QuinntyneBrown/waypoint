@startuml
left to right direction
title UML class structure — Record check-ins
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
package "Frontend — Portal application" {
  class "AuthStore" as page_AuthStore <<Angular component>> {
    +submit(): void
    +renderResult(): void
  }
  class "AuthService" as client_AuthApi <<API client>> {
    +execute(request): Observable
  }
}
package "Backend — Waypoint API application" {
  class "CheckInsController" as controller_CheckInsController <<controller>> {
    +PostAsync(request, cancellationToken): ActionResult
  }
}
package "Backend — Waypoint Application" {
  class "CheckInHistoryQuery" as request_CheckInHistoryQuery <<record>>
  class "CheckInHistoryQueryHandler" as handler_CheckInHistoryQueryHandler <<handler>> {
    +Handle(request, cancellationToken): Result
  }
  interface IAppDbContext {
    +SaveChangesAsync(cancellationToken): int
  }
  interface ICurrentUser {
    +Id: Guid
    +Role: string
  }
}
package "Backend — Waypoint Domain" {
  class "CheckIn" as entity_CheckIn <<domain type>>
}
page_AuthStore --> client_AuthApi : invokes
client_AuthApi --> controller_CheckInsController : calls
controller_CheckInsController ..> request_CheckInHistoryQuery : creates
request_CheckInHistoryQuery --> handler_CheckInHistoryQueryHandler : dispatched to
handler_CheckInHistoryQueryHandler --> IAppDbContext : depends on
handler_CheckInHistoryQueryHandler --> ICurrentUser : scopes by
handler_CheckInHistoryQueryHandler --> entity_CheckIn : reads or changes
IAppDbContext o-- entity_CheckIn : persists
legend right
  Solid arrows show runtime collaboration.
  Dashed arrows show construction.
  Aggregation shows persistence ownership.
endlegend
@enduml
