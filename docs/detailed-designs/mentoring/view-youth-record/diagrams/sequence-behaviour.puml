@startuml

title UML sequence behaviour — View a youth record
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Mentor" as actor
box "Frontend — Portal application" #E0F2FE
  participant "YouthAnnouncements" as page
  participant "PublicSiteApi" as client
end box
box "Backend — WordUp API application" #D1FADF
  participant "MentorController" as controller
end box
box "Backend — WordUp Application and Domain" #ECFDF3
  participant "YouthDetailQueryHandler" as handler
  participant "Flag" as entity
end box
box "Backend — WordUp Infrastructure" #FFF4E5
  database "Word Up database" as db
end box
actor -> page : Start view a youth record
page -> client : Build typed request
client -> controller : HTTPS request
controller -> controller : Authenticate and apply endpoint policy
controller -> handler : Send YouthDetailQuery
handler -> db : Query authorized state
db --> handler : Current state
handler -> entity : Apply L2-MENTOR-002, L2-AUTH-009, L2-CONSENT-004 feature rules
entity --> handler : Valid state transition or projection
handler -> db : Complete bounded projection
db --> handler : Commit or query result
handler --> controller : Typed result
controller --> client : HTTP response or ProblemDetails
client --> page : Feature result
page --> actor : Present view a youth record result
@enduml
