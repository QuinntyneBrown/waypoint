@startuml
left to right direction
title UML class structure — Grade submissions
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
package "Frontend — Portal application" {
  class "YouthNotifications" as page_YouthNotifications <<Angular component>> {
    +submit(): void
    +renderResult(): void
  }
  class "NotificationPreferencesApi" as client_NotificationPreferencesApi <<API client>> {
    +execute(request): Observable
  }
}
package "Backend — WordUp API application" {
  class "MentorController" as controller_MentorController <<controller>> {
    +PostAsync(request, cancellationToken): ActionResult
  }
}
package "Backend — WordUp Application" {
  class "GradeSubmissionCommand" as request_GradeSubmissionCommand <<record>>
  class "GradeSubmissionCommandHandler" as handler_GradeSubmissionCommandHandler <<handler>> {
    +Handle(request, cancellationToken): Result
  }
  interface IAppDbContext {
    +SaveChangesAsync(cancellationToken): int
  }
  interface ICurrentUser {
    +Id: Guid
    +Role: string
  }
}
package "Backend — WordUp Domain" {
  class "GradeSubmissionsState" as entity_GradeSubmissionsState <<domain type>>
}
page_YouthNotifications --> client_NotificationPreferencesApi : invokes
client_NotificationPreferencesApi --> controller_MentorController : calls
controller_MentorController ..> request_GradeSubmissionCommand : creates
request_GradeSubmissionCommand --> handler_GradeSubmissionCommandHandler : dispatched to
handler_GradeSubmissionCommandHandler --> IAppDbContext : depends on
handler_GradeSubmissionCommandHandler --> ICurrentUser : scopes by
handler_GradeSubmissionCommandHandler --> entity_GradeSubmissionsState : reads or changes
IAppDbContext o-- entity_GradeSubmissionsState : persists
legend right
  Solid arrows show runtime collaboration.
  Dashed arrows show construction.
  Aggregation shows persistence ownership.
endlegend
@enduml
