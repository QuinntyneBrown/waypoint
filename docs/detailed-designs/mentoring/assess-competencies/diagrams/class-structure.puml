@startuml
left to right direction
title UML class structure — Assess competencies
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
package "Frontend — Portal application" {
  class "YouthAnnouncements" as page_YouthAnnouncements <<Angular component>> {
    +submit(): void
    +renderResult(): void
  }
  class "AnnouncementsApi" as client_AnnouncementsApi <<API client>> {
    +execute(request): Observable
  }
}
package "Backend — WordUp API application" {
  class "CompetenciesController" as controller_CompetenciesController <<controller>> {
    +PostAsync(request, cancellationToken): ActionResult
  }
}
package "Backend — WordUp Application" {
  class "YouthCompetenciesQuery" as request_YouthCompetenciesQuery <<record>>
  class "YouthCompetenciesQueryHandler" as handler_YouthCompetenciesQueryHandler <<handler>> {
    +Handle(request, cancellationToken): Result
  }
  interface IAppDbContext {
    +SaveChangesAsync(cancellationToken): int
  }
  interface ICurrentUser {
    +Id: Guid
    +Role: string
  }
}
package "Backend — WordUp Domain" {
  class "CompetencyAssessment" as entity_CompetencyAssessment <<domain type>>
}
page_YouthAnnouncements --> client_AnnouncementsApi : invokes
client_AnnouncementsApi --> controller_CompetenciesController : calls
controller_CompetenciesController ..> request_YouthCompetenciesQuery : creates
request_YouthCompetenciesQuery --> handler_YouthCompetenciesQueryHandler : dispatched to
handler_YouthCompetenciesQueryHandler --> IAppDbContext : depends on
handler_YouthCompetenciesQueryHandler --> ICurrentUser : scopes by
handler_YouthCompetenciesQueryHandler --> entity_CompetencyAssessment : reads or changes
IAppDbContext o-- entity_CompetencyAssessment : persists
legend right
  Solid arrows show runtime collaboration.
  Dashed arrows show construction.
  Aggregation shows persistence ownership.
endlegend
@enduml
