@startuml

title UML sequence behaviour — Sync attendance reliably
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Waypoint participant" as actor
box "Frontend — Portal application" #E0F2FE
  participant "AttendanceQueueService" as page
  participant "NonFunctionalApi" as client
end box
box "Backend — Waypoint API application" #D1FADF
  participant "NonFunctionalController" as controller
end box
box "Backend — Waypoint Application and Domain" #ECFDF3
  participant "SyncAttendanceReliablyCommandHandler" as handler
  participant "SyncAttendanceReliablyState" as entity
end box
box "Backend — Waypoint Infrastructure" #FFF4E5
  database "Waypoint database" as db
end box
actor -> page : Start sync attendance reliably
page -> client : Build typed request
client -> controller : HTTPS request
controller -> controller : Authenticate and apply endpoint policy
controller -> handler : Send SyncAttendanceReliablyCommand
handler -> db : Load and persist authorized state
db --> handler : Current state
handler -> entity : Apply L2-NFR-004, L2-ENGAGE-003, L2-NFR-006 feature rules
entity --> handler : Valid state transition or projection
handler -> db : Save changes in one unit of work
db --> handler : Commit or query result
handler --> controller : Typed result
controller --> client : HTTP response or ProblemDetails
client --> page : Feature result
page --> actor : Present sync attendance reliably result
@enduml
