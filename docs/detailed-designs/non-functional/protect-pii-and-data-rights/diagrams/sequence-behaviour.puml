@startuml

title UML sequence behaviour — Protect PII and data rights
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Word Up participant" as actor
box "Frontend — Public Site application" #E0F2FE
  participant "ConsentRequired" as page
  participant "AuthApi" as client
end box
box "Backend — WordUp API application" #D1FADF
  participant "NonFunctionalController" as controller
end box
box "Backend — WordUp Application and Domain" #ECFDF3
  participant "ProtectPiiAndDataRightsCommandHandler" as handler
  participant "ProtectPiiAndDataRightsState" as entity
end box
box "Backend — WordUp Infrastructure" #FFF4E5
  database "Word Up database" as db
end box
actor -> page : Start protect pii and data rights
page -> client : Build typed request
client -> controller : HTTPS request
controller -> controller : Authenticate and apply endpoint policy
controller -> handler : Send ProtectPiiAndDataRightsCommand
handler -> db : Load and persist authorized state
db --> handler : Current state
handler -> entity : Apply L2-NFR-003, L2-CONSENT-001, L2-AUTH-010, L2-NFR-011 feature r…
entity --> handler : Valid state transition or projection
handler -> db : Save changes in one unit of work
db --> handler : Commit or query result
handler --> controller : Typed result
controller --> client : HTTP response or ProblemDetails
client --> page : Feature result
page --> actor : Present protect pii and data rights result
@enduml
