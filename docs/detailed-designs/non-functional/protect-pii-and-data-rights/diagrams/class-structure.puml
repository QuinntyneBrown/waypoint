    +Handle(request, cancellationToken): Result
  }
  interface IAppDbContext {
    +SaveChangesAsync(cancellationToken): int
  }
  interface ICurrentUser {
    +Id: Guid
    +Role: string
  }
}
package "Backend — Waypoint Domain" {
  class "ProtectPiiAndDataRightsState" as entity_ProtectPiiAndDataRightsState <<domain type>>
}
page_ConsentRequired --> client_AuthApi : invokes
client_AuthApi --> controller_NonFunctionalController : calls
controller_NonFunctionalController ..> request_ProtectPiiAndDataRightsCommand : creates
request_ProtectPiiAndDataRightsCommand --> handler_ProtectPiiAndDataRightsCommandHandler : dispatched to
