@startuml

title UML sequence behaviour — Meet performance budgets
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Word Up participant" as actor
box "Frontend — Public Site application" #E0F2FE
  participant "MeetPerformanceBudgetsPage" as page
  participant "NonFunctionalApi" as client
end box
box "Backend — WordUp API application" #D1FADF
  participant "NonFunctionalController" as controller
end box
box "Backend — WordUp Application and Domain" #ECFDF3
  participant "MeetPerformanceBudgetsCommandHandler" as handler
  participant "MeetPerformanceBudgetsState" as entity
end box
box "Backend — WordUp Infrastructure" #FFF4E5
  database "Word Up database" as db
end box
actor -> page : Start meet performance budgets
page -> client : Build typed request
client -> controller : HTTPS request
controller -> controller : Authenticate and apply endpoint policy
controller -> handler : Send MeetPerformanceBudgetsCommand
handler -> db : Load and persist authorized state
db --> handler : Current state
handler -> entity : Apply L2-NFR-008 feature rules
entity --> handler : Valid state transition or projection
handler -> db : Save changes in one unit of work
db --> handler : Commit or query result
handler --> controller : Typed result
controller --> client : HTTP response or ProblemDetails
client --> page : Feature result
page --> actor : Present meet performance budgets result
@enduml
