@startuml

title UML sequence behaviour — Operate and observe the system
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Platform operator" as actor
box "Frontend — Portal application" #E0F2FE
  participant "NotFound" as page
  participant "NonFunctionalApi" as client
end box
box "Backend — WordUp API application" #D1FADF
  participant "NonFunctionalController" as controller
end box
box "Backend — WordUp Application and Domain" #ECFDF3
  participant "OperateAndObserveSystemCommandHandler" as handler
  participant "OperateAndObserveSystemState" as entity
end box
box "Backend — WordUp Infrastructure" #FFF4E5
  database "Word Up database" as db
end box
actor -> page : Start operate and observe the system
page -> client : Build typed request
client -> controller : HTTPS request
controller -> controller : Authenticate and apply endpoint policy
controller -> handler : Send OperateAndObserveSystemCommand
handler -> db : Load and persist authorized state
db --> handler : Current state
handler -> entity : Apply L2-NFR-011 feature rules
entity --> handler : Valid state transition or projection
handler -> db : Save changes in one unit of work
db --> handler : Commit or query result
handler --> controller : Typed result
controller --> client : HTTP response or ProblemDetails
client --> page : Feature result
page --> actor : Present operate and observe the system result
@enduml
