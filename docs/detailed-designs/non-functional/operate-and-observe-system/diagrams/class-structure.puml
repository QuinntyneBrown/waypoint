@startuml
left to right direction
title UML class structure — Operate and observe the system
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
package "Frontend — Portal application" {
  class "NotFound" as page_NotFound <<Angular component>> {
    +submit(): void
    +renderResult(): void
  }
  class "NonFunctionalService" as client_NonFunctionalApi <<API client>> {
    +execute(request): Observable
  }
}
package "Backend — Waypoint API application" {
  class "NonFunctionalController" as controller_NonFunctionalController <<controller>> {
    +PostAsync(request, cancellationToken): ActionResult
  }
}
package "Backend — Waypoint Application" {
  class "OperateAndObserveSystemCommand" as request_OperateAndObserveSystemCommand <<record>>
  class "OperateAndObserveSystemCommandHandler" as handler_OperateAndObserveSystemCommandHandler <<handler>> {
    +Handle(request, cancellationToken): Result
  }
  interface IAppDbContext {
    +SaveChangesAsync(cancellationToken): int
  }
  interface ICurrentUser {
    +Id: Guid
    +Role: string
  }
}
package "Backend — Waypoint Domain" {
  class "OperateAndObserveSystemState" as entity_OperateAndObserveSystemState <<domain type>>
}
page_NotFound --> client_NonFunctionalApi : invokes
client_NonFunctionalApi --> controller_NonFunctionalController : calls
controller_NonFunctionalController ..> request_OperateAndObserveSystemCommand : creates
request_OperateAndObserveSystemCommand --> handler_OperateAndObserveSystemCommandHandler : dispatched to
handler_OperateAndObserveSystemCommandHandler --> IAppDbContext : depends on
handler_OperateAndObserveSystemCommandHandler --> ICurrentUser : scopes by
handler_OperateAndObserveSystemCommandHandler --> entity_OperateAndObserveSystemState : reads or changes
IAppDbContext o-- entity_OperateAndObserveSystemState : persists
legend right
  Solid arrows show runtime collaboration.
  Dashed arrows show construction.
  Aggregation shows persistence ownership.
endlegend
@enduml
